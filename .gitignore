# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
.env*
!.env.example

# Astro site
site/node_modules/
site/dist/
site/.astro/

# Playwright artifacts
site/test-results/
site/playwright-report/

# Synced by site/scripts/convert-content.mjs from the repo's icons/ and
# screenshots/ dirs on every build — never edit or commit these copies
site/public/icons/
site/public/screenshots/

# convert-content.mjs's own scratch directories (beginRegenerate/
# commitRegenerate): a crash mid-run leaves one of these orphaned rather
# than the real collection directory it was about to replace. Harmless on
# disk — the next run clears it before reuse — but never something to commit.
site/src/content/.*.tmp/
