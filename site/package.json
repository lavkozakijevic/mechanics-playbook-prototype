    "astro": "^6.4.6",
    "js-yaml": "^4.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "wrangler": "^4.145.0"
  }
