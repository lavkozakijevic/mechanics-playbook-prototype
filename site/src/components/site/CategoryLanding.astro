---
// Shared template for every category landing page (/finance, /productivity, …).
// Fixed section order: hero, logo strip, the problem, the guide, the plan,
// what this replaces, the free report, the newsletter, the ethics/stance
// band, closing. "Access the library" is the one paid CTA, appearing three
// times with identical wording: hero, the plan, and closing (plus the site
// nav, which is chrome, not page content). "Subscribe" is reserved for the
// newsletter's own button — the two verbs are never mixed. Consulting is
// reachable as one quiet line at the very end ("Book an audit"), and nowhere
// else.
// The hero copy, the six problems (each naming one real mechanic and one real
// app with a complete write-up), the guide, and the two capture sections are
// category-specific (supplied by the content file). The plan, what this
// replaces, the stance band, and the closing band are shared and hardcoded
// here so a new category is still just one content file.
import { getEntry, getCollection } from "astro:content";
import { ReportCapture } from "./ReportCapture.jsx";
import { Hero } from "./HomeTop.jsx";
import { publishedApps, publishedMechanics } from "../../lib/content";

interface Props {
  cat: {
    slug: string;
    name: string;
    hero: { kicker: string; headline: string; sub: string };
    logoStrip?: { label: string };
    problems: {
      title: string;
      items: { title: string; lead: string; body: string; mechanicId: string; appId: string }[];
    };
    guide: { kicker: string; body: string; crossCategoryBody: string };
    reportCapture: { eyebrow: string; body: string; imageHref?: string };
    weeklyDigest: { kicker: string; title: string; body: string };
    heroApps?: { id: string; name: string }[];
  };
}
const { cat } = Astro.props;

// Carousel: logo cards for categories that supply heroApps, otherwise fall back
// to the homepage spotlight app's core mechanics.
const settings = (await getEntry("settings", "homepage"))!.data;
const carousel = await (async () => {
  if (cat.heroApps && cat.heroApps.length > 0) {
    return cat.heroApps.map((a) => ({ logoOnly: true, id: a.id, name: a.name }));
  }
  const allApps = await getCollection("apps");
  const allMechanics = await getCollection("mechanics");
  const byMechId = new Map(allMechanics.map((m) => [m.data.id, m.data]));
  const spotlightApp = allApps.find((a) => a.data.id === settings.spotlightApp)?.data;
  const shortShot = (s?: string) => (s ? s.split(/ showing | with |,/)[0] : "Screen study");
  return spotlightApp
    ? spotlightApp.mechanics
        .filter((r) => r.depth === "core")
        .map((r) => ({
          app: spotlightApp.name,
          mechanic: byMechId.get(r.id)?.name ?? r.id,
          cat: byMechId.get(r.id)?.cat ?? "retention",
          screen: shortShot(r.suggestedShots[0]),
          title: `How ${spotlightApp.name} uses ${byMechId.get(r.id)?.name ?? r.id}`,
        }))
    : [];
})();

const apps = await publishedApps();
const mechanics = await publishedMechanics();
const appById = new Map(apps.map((a) => [a.data.id, a.data]));
const mechById = new Map(mechanics.map((m) => [m.data.id, m.data]));

const heroCtas = [
  { label: "Access the library", href: "/subscribe/", variant: "accent" },
  { label: "Get the free report", href: "#free-report", variant: "link" },
];

// Section 3's items each name one real mechanic and one real app; verify both
// exist so a bad reference fails the build rather than shipping quietly.
for (const item of cat.problems.items) {
  if (!mechById.has(item.mechanicId)) throw new Error(`${cat.slug}: problem "${item.title}" references unknown mechanic "${item.mechanicId}"`);
  if (!appById.has(item.appId)) throw new Error(`${cat.slug}: problem "${item.title}" references unknown app "${item.appId}"`);
}

// Section 5: the plan. Fully shared copy, not category-specific.
const PLAN_STEPS = [
  {
    title: "Access the library.",
    body: "Your product, growth, and design people get the full collection: app breakdowns, mechanics with the psychology behind them, systems, cheatsheets, and shortcasts.",
  },
  {
    title: "Find what fits your problem.",
    body: "Searching by problem, mechanic, or app, with new breakdowns added every week.",
  },
  {
    title: "Adapt it to your product.",
    body: "On your own, or with an audit if you want our eyes on your specific app.",
  },
];
---

<main id="main">
  {/* 1. Hero — category-specific copy, shared carousel */}
  <Hero
    client:load
    carousel={carousel}
    eyebrow={cat.hero.kicker}
    headline={cat.hero.headline}
    sub={cat.hero.sub}
    ctas={heroCtas}
    className="catland-hero"
    evidenceLabel={cat.logoStrip?.label}
  />

  {/* 3. The problem — six real mechanic/app pairs */}
  <section class="band band--sheet" aria-labelledby="prob-h">
    <div class="container">
      <h2 class="mech-section__title" id="prob-h">{cat.problems.title}</h2>
      <ol class="catland-problems">
        {cat.problems.items.map((p, i) => (
          <li class="catland-problem">
            <span class="catland-problem__n" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
            <div>
              <h3>{p.title}</h3>
              <p class="catland-problem__lead">{p.lead}</p>
              <p>{p.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* 4. The guide — what the library is, plus the cross-category argument */}
  <section class="band band--sheet" aria-label={cat.guide.kicker}>
    <div class="container">
      <div class="catland-why">
        <div class="mech-section__kicker">{cat.guide.kicker}</div>
        <p class="catland-why__p">{cat.guide.body}</p>
        <p class="catland-why__p">{cat.guide.crossCategoryBody}</p>
      </div>
    </div>
  </section>

  {/* 5. The plan — shared three steps, ending in the CTA */}
  <section class="band" aria-label="How it works">
    <div class="container">
      <div class="mech-section__kicker">How it works</div>
      <ol class="catland-problems">
        {PLAN_STEPS.map((s, i) => (
          <li class="catland-problem">
            <span class="catland-problem__n" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
            <div>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </div>
          </li>
        ))}
      </ol>
      <a class="gb-btn gb-btn--accent gb-btn--lg catland-plan__cta" href="/subscribe/">Access the library</a>
    </div>
  </section>

  {/* 6. What this replaces — no kicker, one paragraph, shared copy */}
  <section class="band band--sheet" aria-label="What this replaces">
    <div class="container container--narrow">
      <p class="catland-why__p">The alternative is the feature designed from guesswork: the streak shipped because Duolingo has one, the leaderboard that quietly demotivates, the reward schedule built for someone else's product. With precedent in front of them, your team makes fewer guesses, decides faster, and ships engagement design that holds users because it fits them.</p>
    </div>
  </section>

  {/* 7. The free report — first capture point */}
  <section class="band band--sunken" id="free-report" aria-labelledby="report-h">
    <div class="container">
      <div class="catland-report">
        <div class="catland-report__cover" aria-hidden="true">
          {cat.reportCapture.imageHref
            ? (
              <Fragment>
                <img
                  src={cat.reportCapture.imageHref}
                  alt=""
                  loading="lazy"
                  onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"
                />
                <div class="catland-report__placeholder" style="display:none"><span>Report&nbsp;preview</span></div>
              </Fragment>
            )
            : <div class="catland-report__placeholder"><span>Report&nbsp;preview</span></div>
          }
        </div>
        <div class="report-landing__card">
          <div class="eyebrow" style="color:var(--text-accent);margin-bottom:12px">{cat.reportCapture.eyebrow}</div>
          <h2 id="report-h">Get the free {cat.name.toLowerCase()} report</h2>
          <p style="font:var(--type-body-lg);color:var(--text-secondary);max-width:52ch;margin-bottom:24px">{cat.reportCapture.body}</p>
          <div class="report-landing__capture">
            <ReportCapture
              client:load
              category={cat.slug}
              source="category-report"
              submitLabel="Get the free report"
              note="Three breakdowns a week. Unsubscribe at any time."
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* 8. The newsletter — second, separate capture point */}
  <section class="band" aria-labelledby="digest-h">
    <div class="container">
      <div class="catland-report">
        <div class="catland-report__cover" aria-hidden="true">
          <div class="catland-report__placeholder"><span>Newsletter</span></div>
        </div>
        <div class="report-landing__card">
          <div class="eyebrow" style="color:var(--text-accent);margin-bottom:12px">{cat.weeklyDigest.kicker}</div>
          <h2 id="digest-h">{cat.weeklyDigest.title}</h2>
          <p style="font:var(--type-body-lg);color:var(--text-secondary);max-width:52ch;margin-bottom:24px">{cat.weeklyDigest.body}</p>
          <div class="report-landing__capture">
            <ReportCapture
              client:load
              category={cat.slug}
              source="category-newsletter"
              submitLabel="Subscribe"
              note="Unsubscribe at any time."
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* 9. Ethics block — kept unchanged */}
  <section class="band band--sheet" aria-labelledby="stance-h">
    <div class="container">
      <div class="catland-trust">
        <h2 class="mech-section__title" id="stance-h">Engagement that respects the customer</h2>
        <p class="catland-trust__p">The same mechanics that can trap a person can also genuinely help them. We document both, and we say which is which. The habits worth building are the ones that leave a customer better off, and those are the ones we point product teams toward.</p>
      </div>
    </div>
  </section>

  {/* 10. Closing */}
  <section class="band band--ink sp-close" aria-labelledby="close-h">
    <div class="container container--narrow">
      <h2 class="sp-close__h" id="close-h">Build on what has already shipped.</h2>
      <a class="gb-btn gb-btn--accent gb-btn--lg" href="/subscribe/">Access the library</a>
    </div>
  </section>

  <div class="container">
    <p class="catland-transition">Working on a specific problem in your app? <a href="/work-with-us/">Book an audit</a></p>
  </div>
</main>
