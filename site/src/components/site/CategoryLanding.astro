---
// Shared template for every category landing page (/finance, /productivity, …).
// The category content file supplies the specific blocks (hero, the six
// problems, the report). The lens, the trust section, and the call are shared:
// a category may override any of them, otherwise these defaults apply — so a
// new category is still just one content file.
import { ReportCapture } from "./ReportCapture.jsx";

interface Props {
  cat: {
    slug: string;
    name: string;
    hero: { kicker: string; headline: string; sub: string };
    problems: { kicker: string; title: string; items: { title: string; lead: string; body: string }[] };
    lens?: { kicker: string; title: string; body: string };
    trust?: { kicker?: string; title: string; body: string };
    call?: { title: string; body: string };
    report: {
      eyebrow: string;
      title: string;
      body: string;
      stats?: { n: string; l: string }[];
      fileHref: string;
      fileLabel: string;
    };
  };
}
const { cat } = Astro.props;

// Shared-block defaults, inherited by any category that doesn't override them.
const lens = cat.lens ?? {
  kicker: "How games work",
  title: "A few simple ideas, working together",
  body: "A good game rarely leans on one clever trick. It gives a person a clear thing to aim for, makes the progress toward it visible, and offers a small, well timed reward for getting there. Each idea is modest on its own; put together with care, they are what turn something a person tries once into something they return to without being asked.",
};
const trust = cat.trust ?? {
  title: "Engagement that respects the customer",
  body: "The same mechanics that can trap a person can also genuinely help them. We care about which side of that line your product is built on. The habits worth creating are the ones that leave a customer better off, and those are the only ones we help you build.",
};
const call = cat.call ?? {
  title: "Bring us your app and a problem",
  body: "Tell us what you are working on and where it stalls. In half an hour we can usually point to two or three places where game design would genuinely help, and how to approach each one.",
};
---

<main id="main">
  {/* Hero — category-specific */}
  <section class="catland-hero" aria-labelledby="cat-h">
    <div class="container">
      <div class="catland-hero__in">
        <div class="eyebrow">{cat.hero.kicker}</div>
        <h1 id="cat-h">{cat.hero.headline}</h1>
        <p class="catland-hero__sub">{cat.hero.sub}</p>
        <div class="catland-hero__cta">
          <a class="gb-btn gb-btn--secondary gb-btn--lg" href="/work-with-us/">Book a call</a>
          <a class="gb-btn gb-btn--accent gb-btn--lg" href="#get-report">Get the free report</a>
        </div>
      </div>
    </div>
  </section>

  {/* The six problems — category-specific */}
  <section class="band band--sheet" aria-labelledby="prob-h">
    <div class="container">
      <div class="mech-section__kicker">{cat.problems.kicker}</div>
      <h2 class="mech-section__title" id="prob-h">{cat.problems.title}</h2>
      <ol class="catland-problems">
        {cat.problems.items.map((p, i) => (
          <li class="catland-problem">
            <span class="catland-problem__n" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
            <div>
              <h3>{p.title}</h3>
              <p class="catland-problem__lead">{p.lead}</p>
              <p>{p.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* The lens — shared (overridable) */}
  <section class="band" aria-labelledby="lens-h">
    <div class="container">
      <div class="catland-lens">
        <div class="mech-section__kicker">{lens.kicker}</div>
        <h2 class="mech-section__title" id="lens-h">{lens.title}</h2>
        <p class="catland-lens__p">{lens.body}</p>
      </div>
    </div>
  </section>

  {/* The report — category-specific, with the email-gated download */}
  <section class="band band--sunken" id="get-report" aria-labelledby="report-h">
    <div class="container">
      <div class="report-landing">
        <div class="report-landing__card">
          <div class="eyebrow" style="color:var(--text-accent);margin-bottom:12px">{cat.report.eyebrow}</div>
          <h2 id="report-h">{cat.report.title}</h2>
          <p style="font:var(--type-body-lg);color:var(--text-secondary);max-width:52ch;margin-bottom:24px">{cat.report.body}</p>
          {cat.report.stats && cat.report.stats.length > 0 && (
            <div class="report-landing__stats">
              {cat.report.stats.map((s) => (
                <div class="report-landing__stat"><span class="report-landing__n">{s.n}</span><span class="report-landing__l">{s.l}</span></div>
              ))}
            </div>
          )}
          <div class="report-landing__capture">
            <ReportCapture
              client:load
              category={cat.slug}
              source="category-report"
              fileHref={cat.report.fileHref}
              fileLabel={cat.report.fileLabel}
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* The trust section — shared (overridable) */}
  <section class="band" aria-labelledby="trust-h">
    <div class="container">
      <div class="catland-trust">
        {trust.kicker && <div class="mech-section__kicker">{trust.kicker}</div>}
        <h2 class="mech-section__title" id="trust-h">{trust.title}</h2>
        <p class="catland-trust__p">{trust.body}</p>
      </div>
    </div>
  </section>

  {/* The call — shared (overridable); one action */}
  <section class="band band--ink catland-call" aria-labelledby="call-h">
    <div class="container">
      <div class="catland-call__in">
        <h2 id="call-h">{call.title}</h2>
        <p>{call.body}</p>
        <div class="catland-call__cta">
          <a class="gb-btn gb-btn--accent gb-btn--lg" href="/work-with-us/">Book a call</a>
        </div>
      </div>
    </div>
  </section>
</main>
