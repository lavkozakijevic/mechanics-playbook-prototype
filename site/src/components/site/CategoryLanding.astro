---
// Shared template for every category landing page (/finance, /productivity, …).
// Fixed section order: hero, logo strip, problem cards, show-don't-tell,
// what you get, cross-category, how it works, email block, closing.
// "Access the library" is the one paid CTA (hero, how it works, closing), all
// pointing at /subscribe/. The email block (section 8) is the only form on
// the page. Consulting is reachable as one quiet line at the very end, and
// nowhere else.
// The hero copy, the logo strip caption, the three problem cards, and the
// cross-category sentence are category-specific (supplied by the content
// file). Show-don't-tell, what you get, how it works, the email block, and
// closing are shared and hardcoded here so a new category is still just one
// content file.
import { getEntry, getCollection } from "astro:content";
import { ReportCapture } from "./ReportCapture.jsx";
import { Hero } from "./HomeTop.jsx";
import { AnnotatedScreenshot } from "../ds/AnnotatedScreenshot.jsx";
import { publishedApps, publishedMechanics } from "../../lib/content";

interface Props {
  cat: {
    slug: string;
    name: string;
    hero: { headline: string; sub: string };
    logoStrip?: { caption: string };
    problemCards: { text: string }[];
    crossCategory: { sentence: string };
    heroApps?: { id: string; name: string }[];
  };
}
const { cat } = Astro.props;

const apps = await publishedApps();
const mechanics = await publishedMechanics();

// Section 1: the hero visual is a real case-study visual, not category-specific.
const HERO_IMAGE = {
  src: "/images/strava-case-study.png",
  alt: "The Strava breakdown page, showing its streak, achievements, leaderboards, and social feed screens",
  appName: "Strava",
  screenLabel: "Breakdown, in full",
};
const heroCtas = [
  { label: "Access the library", href: "/subscribe/", variant: "accent" },
  { label: "Get the free finance report", href: "#free-report", variant: "link" },
];

// Section 4: three real pins on the same Strava visual, pointing at the parts
// of the write-up format that back this page's claims.
const SHOW_DONT_TELL_PINS = [
  { n: 1, x: 24, y: 24, note: "What was observed: the concrete detail behind every claim." },
  { n: 2, x: 50, y: 62, note: "Conditions: when the mechanic works, and when it would not." },
  { n: 3, x: 78, y: 30, note: "How mechanics connect: the pairs that make the loop hold together." },
];

// Section 5: four tiles, counts computed live so they never drift.
const LIBRARY_TILES = [
  { n: apps.length, label: "app breakdowns", body: "real apps, torn down mechanic by mechanic", href: "/case-studies/" },
  { n: mechanics.length, label: "mechanics", body: "each defined: works when, backfires when", href: "/mechanics/" },
  { n: null, label: "Systems and cheatsheets", body: "how the pieces combine", href: "/systems/" },
  { n: 3, label: "new breakdowns every week", body: null, href: "/case-studies/" },
];

// Section 6: generic stand-ins for Duolingo and Candy Crush — their brand
// icons are not in this repo, and pulling them in raises a licensing
// question, so this uses labeled placeholders instead of the real logos.
const CROSS_CATEGORY_APPS = [
  { kind: "icon", id: "strava", label: "Strava" },
  { kind: "icon", id: cat.heroApps?.[0]?.id ?? "revolut", label: cat.heroApps?.[0]?.name ?? "Finance app" },
  { kind: "stand-in", label: "Language app" },
  { kind: "stand-in", label: "Puzzle game" },
];

// Section 7: shared, not category-specific.
const HOW_IT_WORKS = [
  "Get your team access.",
  "Search by problem, mechanic, or app.",
  "Build on what shipped, instead of guessing.",
];

// Section 3: one minimal line icon per problem card, matching the site's
// existing stroke style. Index-matched to cat.problemCards.
const PROBLEM_ICONS = [
  // flattening line (retention curve)
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 16c4 0 5-9 8-9s3 6 6 6 3-1 4-1"/></svg>`,
  // blank page
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 3h7l4 4v14H7z"/><path d="M14 3v4h4"/></svg>`,
  // broken chain link (a copied streak that didn't take)
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 15l-1.5 1.5a3 3 0 01-4.2-4.2L4 10.5"/><path d="M16 9l1.5-1.5a3 3 0 014.2 4.2L20 13.5"/><path d="M9.5 14.5l1-1"/><path d="M13.5 10.5l1-1"/></svg>`,
];
---

<main id="main">
  {/* 1. Hero — category-specific copy, one real breakdown visual */}
  <Hero
    client:load
    heroImage={HERO_IMAGE}
    eyebrow=""
    headline={cat.hero.headline}
    sub={cat.hero.sub}
    ctas={heroCtas}
    className="catland-hero"
  />

  {/* 2. Logo strip — existing logos, new caption */}
  {cat.heroApps && cat.heroApps.length > 0 && (
    <section class="band band--sheet catland-logostrip" aria-label={cat.logoStrip?.caption ?? "Apps in the library"}>
      <div class="container">
        <div class="catland-logostrip__row">
          {cat.heroApps.map((a) => (
            <img class="catland-logostrip__logo" src={`/icons/${a.id}.webp`} alt={a.name} loading="lazy" />
          ))}
        </div>
        {cat.logoStrip?.caption && <p class="catland-logostrip__caption">{cat.logoStrip.caption}</p>}
      </div>
    </section>
  )}

  {/* 3. Problem cards — three cards, minimal icon, one line, no body copy */}
  <section class="band" aria-label="Problems this library solves">
    <div class="container">
      <ul class="catland-probcards">
        {cat.problemCards.map((p, i) => (
          <li class="catland-probcard">
            <span class="catland-probcard__icon" aria-hidden="true" set:html={PROBLEM_ICONS[i]} />
            <p>{p.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* 4. Show, don't tell — the Strava breakdown, annotated */}
  <section class="band band--sheet" aria-labelledby="show-h">
    <div class="container container--narrow">
      <h2 class="mech-section__title" id="show-h">This is what a breakdown looks like.</h2>
      <AnnotatedScreenshot
        client:visible
        src="/screenshots/achievements/strava/01.jpg"
        alt="The Strava app's trophy case screen, showing achievement badges earned for activity milestones"
        appName="Strava"
        screenLabel="Trophy case"
        annotations={SHOW_DONT_TELL_PINS}
        caption="Every app, taken apart the same way: what it built, how it works, and when it would work in yours."
      />
    </div>
  </section>

  {/* 5. What your team gets — four tiles, live counts */}
  <section class="band" aria-labelledby="gets-h">
    <div class="container">
      <h2 class="mech-section__title" id="gets-h">What your team gets</h2>
      <div class="catland-tiles">
        {LIBRARY_TILES.map((t) => (
          <a class="catland-tile" href={t.href}>
            <h3>{t.n != null ? `${t.n} ${t.label}` : t.label}</h3>
            {t.body && <p>{t.body}</p>}
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* 6. Cross-category */}
  <section class="band band--sheet catland-crosscat" aria-label="Cross-category argument">
    <div class="container">
      <div class="catland-crosscat__grid">
        <p class="catland-crosscat__line">{cat.crossCategory.sentence}</p>
        <div class="catland-phone" aria-hidden="true">
          <div class="catland-phone__screen">
            {CROSS_CATEGORY_APPS.map((a) => (
              a.kind === "icon" ? (
                <div class="catland-phone__app">
                  <img src={`/icons/${a.id}.${a.id === "strava" ? "png" : "webp"}`} alt="" />
                  <span>{a.label}</span>
                </div>
              ) : (
                <div class="catland-phone__app catland-phone__app--standin">
                  <span class="catland-phone__standin-mark" aria-hidden="true">{a.label.slice(0, 1)}</span>
                  <span>{a.label}</span>
                </div>
              )
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* 7. How it works */}
  <section class="band" aria-labelledby="how-h">
    <div class="container">
      <h2 class="mech-section__title" id="how-h">How it works</h2>
      <ol class="catland-howsteps">
        {HOW_IT_WORKS.map((s, i) => (
          <li class="catland-howstep">
            <span class="catland-howstep__n" aria-hidden="true">{i + 1}.</span>
            <span>{s}</span>
          </li>
        ))}
      </ol>
      <a class="gb-btn gb-btn--accent gb-btn--lg catland-plan__cta" href="/subscribe/">Access the library</a>
    </div>
  </section>

  {/* 8. Email block — the only form on the page */}
  <section class="band band--sunken" id="free-report" aria-labelledby="email-h">
    <div class="container container--narrow">
      <h2 class="mech-section__title" id="email-h">Not ready? Start free.</h2>
      <p class="catland-why__p">The finance report now, three new breakdowns in your inbox every week.</p>
      <div class="catland-emailblock">
        <ReportCapture
          client:load
          category={cat.slug}
          source="finance-page-v2"
          submitLabel="Get the report"
        />
      </div>
    </div>
  </section>

  {/* 9. Closing */}
  <section class="band band--ink sp-close" aria-labelledby="close-h">
    <div class="container container--narrow">
      <h2 class="sp-close__h" id="close-h">Give your product team the observatory.</h2>
      <a class="gb-btn gb-btn--accent gb-btn--lg" href="/subscribe/">Access the library</a>
    </div>
  </section>

  <div class="container">
    <p class="catland-transition">Working on a specific problem? <a href="/work-with-us/">Book an audit</a></p>
  </div>
</main>
