---
// Shared template for every category landing page (/finance, /productivity, …).
// Fixed section order: hero, what you get, problem cards, all mechanics (the
// breakdown visual), the systems map, cross-category, how it works, email
// block, closing. The breakdown visual and the systems map are two views of
// the same "what's in the library" idea: one app's full set of mechanics,
// then how those mechanics connect. "Access the library" is the one paid CTA
// (hero, how it works, closing), all pointing at /subscribe/. The email
// block is the only form on the page. Consulting is reachable as one quiet
// line at the very end, and nowhere else.
// The hero copy, the three problem cards, and the cross-category sentence
// are category-specific (supplied by the content file). Everything else is
// shared and hardcoded here so a new category is still just one content
// file.
import { getEntry, getCollection } from "astro:content";
import { ReportCapture } from "./ReportCapture.jsx";
import { Hero } from "./HomeTop.jsx";
import { AnnotatedScreenshot } from "../ds/AnnotatedScreenshot.jsx";
import { SystemMap } from "./SystemDetail.jsx";
import { publishedApps, publishedMechanics } from "../../lib/content";
import { systemProps } from "../../lib/props";

interface Props {
  cat: {
    slug: string;
    name: string;
    hero: { headline: string; sub: string };
    problemCards: { text: string }[];
    crossCategory: { sentence: string };
    heroApps?: { id: string; name: string }[];
  };
}
const { cat } = Astro.props;

const apps = await publishedApps();
const mechanics = await publishedMechanics();

// Section 1: the hero carousel, drawn from this category's own app logos.
const carousel = (cat.heroApps ?? []).map((a) => ({ logoOnly: true, id: a.id, name: a.name }));
const heroCtas = [
  { label: "Access the library", href: "/subscribe/", variant: "accent" },
  { label: "Get the free finance report", href: "#free-report", variant: "link" },
];

// Section 2: four tiles, counts computed live so they never drift.
const LIBRARY_TILES = [
  { n: apps.length, label: "app breakdowns", body: "real apps, torn down mechanic by mechanic", href: "/case-studies/" },
  { n: mechanics.length, label: "mechanics", body: "each defined: works when, backfires when", href: "/mechanics/" },
  { n: null, label: "Systems and cheatsheets", body: "how the pieces combine", href: "/systems/" },
  { n: 3, label: "new breakdowns every week", body: null, href: "/case-studies/" },
];

// Section 4a: the same Strava breakdown visual, now showing the range of
// mechanics one app breakdown covers.
const BREAKDOWN_IMAGE = {
  src: "/images/strava-case-study.png",
  alt: "The Strava breakdown, showing its streak, achievements, leaderboards, and social feed screens",
  appName: "Strava",
  screenLabel: "Full app breakdown",
};

// Section 4b: Strava's real system map, the same diagram the homepage shows.
const stravaEntry = apps.find((a) => a.data.id === "strava")?.data;
const mechById = new Map(mechanics.map((m) => [m.data.id, m.data]));
const stravaSystem = stravaEntry?.system ? systemProps(stravaEntry, mechById) : null;
const systemById = Object.fromEntries((stravaSystem?.nodes ?? []).map((n) => [n.id, n]));

// Section 5: real apps from our own library, not licensed brand icons. One
// finance app, plus non-finance apps we already document.
const CROSS_CATEGORY_APPS = [
  { id: cat.heroApps?.[0]?.id ?? "revolut", ext: "webp", label: cat.heroApps?.[0]?.name ?? "Finance app" },
  { id: "strava", ext: "png", label: "Strava" },
  { id: "calm", ext: "png", label: "Calm" },
  { id: "canva", ext: "png", label: "Canva" },
];

// Section 6: shared, not category-specific.
const HOW_IT_WORKS = [
  "Get your team access.",
  "Search by problem, mechanic, or app.",
  "Build on what shipped, instead of guessing.",
];

// Section 3: one minimal line icon per problem card, matching the site's
// existing stroke style. Index-matched to cat.problemCards.
const PROBLEM_ICONS = [
  // flattening line (retention curve)
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 16c4 0 5-9 8-9s3 6 6 6 3-1 4-1"/></svg>`,
  // blank page
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 3h7l4 4v14H7z"/><path d="M14 3v4h4"/></svg>`,
  // broken chain link (a copied streak that didn't take)
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 15l-1.5 1.5a3 3 0 01-4.2-4.2L4 10.5"/><path d="M16 9l1.5-1.5a3 3 0 014.2 4.2L20 13.5"/><path d="M9.5 14.5l1-1"/><path d="M13.5 10.5l1-1"/></svg>`,
];
---

<main id="main">
  {/* 1. Hero — category-specific copy, the sliding logo carousel */}
  <Hero
    client:load
    carousel={carousel}
    eyebrow=""
    headline={cat.hero.headline}
    sub={cat.hero.sub}
    ctas={heroCtas}
    className="catland-hero"
  />

  {/* 2. What your team gets — four tiles, live counts */}
  <section class="band" aria-labelledby="gets-h">
    <div class="container">
      <h2 class="mech-section__title" id="gets-h">What your team gets</h2>
      <div class="catland-tiles">
        {LIBRARY_TILES.map((t) => (
          <a class="catland-tile" href={t.href}>
            <h3>{t.n != null ? `${t.n} ${t.label}` : t.label}</h3>
            {t.body && <p>{t.body}</p>}
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* 3. Problem cards — three cards, minimal icon, one line, no body copy */}
  <section class="band" aria-label="Problems this library solves">
    <div class="container">
      <ul class="catland-probcards">
        {cat.problemCards.map((p, i) => (
          <li class="catland-probcard">
            <span class="catland-probcard__icon" aria-hidden="true" set:html={PROBLEM_ICONS[i]} />
            <p>{p.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* 4a. All mechanics in the best apps — the full breakdown visual */}
  <section class="band band--sheet" aria-labelledby="mechs-h">
    <div class="container container--narrow">
      <h2 class="mech-section__title" id="mechs-h">All mechanics in the best apps</h2>
      <AnnotatedScreenshot
        client:visible
        src={BREAKDOWN_IMAGE.src}
        alt={BREAKDOWN_IMAGE.alt}
        appName={BREAKDOWN_IMAGE.appName}
        screenLabel={BREAKDOWN_IMAGE.screenLabel}
        caption="Every app, taken apart the same way: what it built, how it works, and when it would work in yours."
      />
    </div>
  </section>

  {/* 4b. The systems map — how the mechanics connect, in the house diagram */}
  {stravaSystem && (
    <section class="band band--sunken" aria-labelledby="sysmap-h">
      <div class="container">
        <div class="showcase">
          <div class="showcase__body">
            <div class="eyebrow">The systems map</div>
            <h2 id="sysmap-h">How the {stravaEntry.name} system holds together</h2>
            <p>{stravaSystem.tagline}</p>
            <a class="gb-btn gb-btn--secondary gb-btn--lg" href={`/systems/${stravaEntry.id}/`}>Explore the {stravaEntry.name} map</a>
          </div>
          <div class="showcase__map">
            <div class="smap-stage">
              <SystemMap client:visible nodes={stravaSystem.nodes} connections={stravaSystem.connections} byId={systemById} />
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  {/* 5. Cross-category */}
  <section class="band band--sheet catland-crosscat" aria-label="Cross-category argument">
    <div class="container">
      <div class="catland-crosscat__grid">
        <p class="catland-crosscat__line">{cat.crossCategory.sentence}</p>
        <div class="catland-phone" aria-hidden="true">
          <div class="catland-phone__screen">
            {CROSS_CATEGORY_APPS.map((a) => (
              <div class="catland-phone__app">
                <img src={`/icons/${a.id}.${a.ext}`} alt="" />
                <span>{a.label}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* 6. How it works */}
  <section class="band" aria-labelledby="how-h">
    <div class="container">
      <h2 class="mech-section__title" id="how-h">How it works</h2>
      <ol class="catland-howsteps">
        {HOW_IT_WORKS.map((s, i) => (
          <li class="catland-howstep">
            <span class="catland-howstep__n" aria-hidden="true">{i + 1}.</span>
            <span>{s}</span>
          </li>
        ))}
      </ol>
      <a class="gb-btn gb-btn--accent gb-btn--lg catland-plan__cta" href="/subscribe/">Access the library</a>
    </div>
  </section>

  {/* 7. Email block — the only form on the page */}
  <section class="band band--sunken" id="free-report" aria-labelledby="email-h">
    <div class="container container--narrow">
      <h2 class="mech-section__title" id="email-h">Not ready? Start free.</h2>
      <p class="catland-why__p">The finance report now, three new breakdowns in your inbox every week.</p>
      <div class="catland-emailblock">
        <ReportCapture
          client:load
          category={cat.slug}
          source="finance-page-v2"
          submitLabel="Get the report"
        />
      </div>
    </div>
  </section>

  {/* 8. Closing */}
  <section class="band band--ink sp-close" aria-labelledby="close-h">
    <div class="container container--narrow">
      <h2 class="sp-close__h" id="close-h">Give your product team the observatory.</h2>
      <a class="gb-btn gb-btn--accent gb-btn--lg" href="/subscribe/">Access the library</a>
    </div>
  </section>

  <div class="container">
    <p class="catland-transition">Working on a specific problem? <a href="/work-with-us/">Book an audit</a></p>
  </div>
</main>
