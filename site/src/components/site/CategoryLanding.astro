---
// Shared template for every category landing page (/finance, /productivity, …).
// The hero opens two paths: into the free library to browse, or straight to a
// sample case study. The email signup is the ask in the middle of the page and
// again at the close; a final band below it points to the paid library.
// Consulting is reachable as one quiet line above the footer, and nowhere else.
// Section order: hero, where we can help, why gamification matters, what is in
// the library, the free report, trust, closing signup, find inspiration (the
// paid-library CTA).
// The hero copy, the six problems, and the report card are category-specific
// (supplied by the content file). All other sections are shared and hardcoded
// here so a new category is still just one content file.
import { getEntry, getCollection } from "astro:content";
import { ReportCapture } from "./ReportCapture.jsx";
import { Hero } from "./HomeTop.jsx";

interface Props {
  cat: {
    slug: string;
    name: string;
    hero: { kicker: string; headline: string; sub: string };
    problems: { kicker: string; title: string; items: { title: string; lead: string; body: string }[] };
    report: {
      eyebrow: string;
      title: string;
      body: string;
      stats?: { n: string; l: string }[];
      imageHref?: string;
    };
    heroApps?: { id: string; name: string }[];
  };
}
const { cat } = Astro.props;

// Carousel: logo cards for categories that supply heroApps, otherwise fall back
// to the homepage spotlight app's core mechanics.
const settings = (await getEntry("settings", "homepage"))!.data;
const carousel = await (async () => {
  if (cat.heroApps && cat.heroApps.length > 0) {
    return cat.heroApps.map((a) => ({ logoOnly: true, id: a.id, name: a.name }));
  }
  const allApps = await getCollection("apps");
  const allMechanics = await getCollection("mechanics");
  const byMechId = new Map(allMechanics.map((m) => [m.data.id, m.data]));
  const spotlightApp = allApps.find((a) => a.data.id === settings.spotlightApp)?.data;
  const shortShot = (s?: string) => (s ? s.split(/ showing | with |,/)[0] : "Screen study");
  return spotlightApp
    ? spotlightApp.mechanics
        .filter((r) => r.depth === "core")
        .map((r) => ({
          app: spotlightApp.name,
          mechanic: byMechId.get(r.id)?.name ?? r.id,
          cat: byMechId.get(r.id)?.cat ?? "retention",
          screen: shortShot(r.suggestedShots[0]),
          title: `How ${spotlightApp.name} uses ${byMechId.get(r.id)?.name ?? r.id}`,
        }))
    : [];
})();

// The hero opens two paths into the library: browse it, or read one sample
// case study first. The email signup is asked for further down the page.
const SAMPLE_BREAKDOWN = "/case-studies/strava/";
const heroCtas = [
  { label: "Access the library", href: "/mechanics/", variant: "accent" },
  { label: "Read a case study", href: SAMPLE_BREAKDOWN, variant: "link" },
];

// Shown under both email forms, so the newsletter is never implied silently.
const CAPTURE_NOTE = "Three new breakdowns every week. Unsubscribe at any time.";
---

<main id="main">
  {/* Hero — category-specific copy, shared carousel */}
  <Hero
    client:load
    carousel={carousel}
    eyebrow={cat.hero.kicker}
    headline={cat.hero.headline}
    sub={cat.hero.sub}
    ctas={heroCtas}
    className="catland-hero"
  />

  {/* Where gamification helps — category-specific problems */}
  <section class="band band--sheet" aria-labelledby="prob-h">
    <div class="container">
      <div class="mech-section__kicker">{cat.problems.kicker}</div>
      <h2 class="mech-section__title" id="prob-h">{cat.problems.title}</h2>
      <ol class="catland-problems">
        {cat.problems.items.map((p, i) => (
          <li class="catland-problem">
            <span class="catland-problem__n" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
            <div>
              <h3>{p.title}</h3>
              <p class="catland-problem__lead">{p.lead}</p>
              <p>{p.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* Why gamification matters — shared */}
  <section class="band band--sheet" aria-labelledby="why-h">
    <div class="container">
      <div class="catland-why">
        <div class="mech-section__kicker">Why gamification matters</div>
        <h2 class="mech-section__title" id="why-h">The same ideas that keep a game open can keep your app open</h2>
        <p class="catland-why__p">The apps that earn daily habits use the same ideas games have refined for decades: a clear goal to aim for, a way to see progress toward it, and a small, well-timed reward for reaching it. None of these ideas are complicated on their own. Put together with care, they turn something a person tries once into something they return to without being asked.</p>
      </div>
    </div>
  </section>

  {/* What's in the library — the sample, the cross-category argument, the cadence */}
  <section class="band" aria-labelledby="lib-h">
    <div class="container">
      <div class="mech-section__kicker">The library</div>
      <h2 class="mech-section__title" id="lib-h">What is in the library</h2>
      <div class="catland-lib">
        <div class="catland-lib__item">
          <h3>A breakdown you can read right now</h3>
          <p>The Strava breakdown is open in full, with no email needed. It walks each mechanic in the loop, what we observed, how the app presents it, and what a product team can take from it.</p>
          <a class="catland-lib__link" href={SAMPLE_BREAKDOWN}>Read the Strava breakdown</a>
        </div>
        <div class="catland-lib__item">
          <h3>Every category, not only {cat.name.toLowerCase()}</h3>
          <p>A {cat.name.toLowerCase()} app competes with Duolingo and Strava for the same minutes on the same phone. So we study every category, and you take the parts that fit your product.</p>
        </div>
        <div class="catland-lib__item">
          <h3>Three new breakdowns every week</h3>
          <p>We publish three every week and send them in the newsletter. Each one covers a single app and the mechanics that keep people coming back to it.</p>
        </div>
      </div>
    </div>
  </section>

  {/* Free report — category-specific, with email-gated download */}
  <section class="band band--sunken" id="get-report" aria-labelledby="report-h">
    <div class="container">
      <div class="catland-report">
        <div class="catland-report__cover" aria-hidden="true">
          {cat.report.imageHref
            ? (
              <Fragment>
                <img
                  src={cat.report.imageHref}
                  alt=""
                  loading="lazy"
                  onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"
                />
                <div class="catland-report__placeholder" style="display:none"><span>Report&nbsp;preview</span></div>
              </Fragment>
            )
            : <div class="catland-report__placeholder"><span>Report&nbsp;preview</span></div>
          }
        </div>
        <div class="report-landing__card">
          <div class="eyebrow" style="color:var(--text-accent);margin-bottom:12px">{cat.report.eyebrow}</div>
          <h2 id="report-h">{cat.report.title}</h2>
          <p style="font:var(--type-body-lg);color:var(--text-secondary);max-width:52ch;margin-bottom:24px">{cat.report.body}</p>
          {cat.report.stats && cat.report.stats.length > 0 && (
            <div class="report-landing__stats">
              {cat.report.stats.map((s) => (
                <div class="report-landing__stat">
                  <span class="report-landing__n">{s.n}</span>
                  <span class="report-landing__l">{s.l}</span>
                </div>
              ))}
            </div>
          )}
          <div class="report-landing__capture">
            <ReportCapture
              client:load
              category={cat.slug}
              source="category-report"
              submitLabel="Get the report"
              note={CAPTURE_NOTE}
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* Trust — shared */}
  <section class="band" aria-labelledby="trust-h">
    <div class="container">
      <div class="catland-trust">
        <h2 class="mech-section__title" id="trust-h">Engagement that respects the customer</h2>
        <p class="catland-trust__p">The same mechanics that can trap a person can also genuinely help them. We care about which side of that line your product is built on. The habits worth creating are the ones that leave a customer better off, and those are the only ones we help you build.</p>
      </div>
    </div>
  </section>

  {/* Closing — the same single ask, with the consulting path kept quiet below it */}
  <section class="band band--sheet catland-signup" aria-labelledby="signup-h">
    <div class="container">
      <div class="catland-signup__in">
        <h2 class="mech-section__title" id="signup-h">Three new breakdowns every week</h2>
        <p class="catland-signup__p">Enter your email and the sample {cat.name.toLowerCase()} report opens straight away. After that we send the three breakdowns we publish each week.</p>
        <div class="catland-signup__form">
          <ReportCapture
            client:load
            category={cat.slug}
            source="category-closing"
            submitLabel="Get the report"
            note={CAPTURE_NOTE}
          />
        </div>
        <p class="catland-signup__alt">Working on a specific problem in your app? <a href="/work-with-us/">Work with us</a></p>
      </div>
    </div>
  </section>

  {/* Find inspiration — the closing pitch for the paid library, reusing the
      dark closing band the old Book a call section defined */}
  <section class="band band--ink catland-call" aria-labelledby="inspire-h">
    <div class="container">
      <div class="catland-call__in">
        <h2 id="inspire-h">Find inspiration for your app</h2>
        <p>The breakdowns you can read for free cover one app at a time. The full library holds every mechanic we have mapped, across every category, with the systems and connections behind each one.</p>
        <div class="catland-call__cta">
          <a class="gb-btn gb-btn--accent gb-btn--lg" href="/subscribe/">Unlock the full library</a>
        </div>
      </div>
    </div>
  </section>
</main>
