---
/**
 * The v4.1 case study summary page body (spec §2.1). Plain Astro, no client
 * hydration for content — see the gating note below.
 *
 * Styled to read as an article, using v3's case-study language throughout,
 * not a parallel invention of it: .cs-hd for the header, .cs-gate for the
 * locked state, .cs-toc for the sticky in-page table of contents,
 * .mech-section__kicker/__title over each of the three top-level sections,
 * .mech-prose for System View's body copy, .cs-chips/.cs-chip for the
 * mechanics-observed row, .cs-msec + .gb-tag + .cs-sub for each mechanic
 * block, and a .csc-style card grid for the full record. Deliberately more
 * generous and editorial than the section pages, which are built to be
 * scanned instead (see CaseStudySectionV41.astro).
 *
 * Mechanic blocks (spec §2.1, revised 11 Sep 2026) are composed prose, not a
 * rendering of the tagged observations — .cs-sub/.cs-sub__h/.cs-findings
 * below are the exact classes CaseStudyDetail.jsx's MechanicSection uses for
 * Strava's write-ups, reused verbatim rather than reinvented for v4.1.
 *
 * Header placement (design review, 11 Sep 2026): the header lives inside
 * .cs-layout/.v41-cs-body, not above it, and is duplicated into the locked
 * branch rather than shared — exactly how CaseStudyDetail.jsx's own
 * LockedCaseStudy/FullCaseStudy each render their own copy. This is what
 * makes .cs-toc sit beside the title from the very top of the page instead
 * of only starting once the body sections begin, and what keeps the
 * header's left edge flush with the body content below it rather than
 * spanning the full container width above the two-column grid.
 */
import { GateWidget } from "./GateWidget.jsx";
import { SystemMap } from "./SystemDetail.jsx";
import { Tag } from "../ds/Tag.jsx";
import { allSectionCounts, tagBlocks, CAT_COLOR, CAT_LABEL } from "../../lib/v41";
import { PREVIEW_UNLOCK } from "../../lib/preview";
import { initials } from "../../lib/props";
import { formatMonthYear, mechanicHref } from "../../lib/content";

interface Props {
  app: any;
  mechanicsById: Map<string, any>;
}

const { app, mechanicsById } = Astro.props as Props;

// Gating (spec §2.1): "not present in HTML at all." This page never reads
// `app.observations`/`systemView`/`proposedTags` into the template below
// this point when locked — there is nothing to strip client-side because
// nothing gated is interpolated in the first place. PREVIEW_UNLOCK is a
// build-time-only override (off by default, see lib/preview.ts) for reading
// gated content locally before authentication exists.
const locked = app.visibility !== "public" && !PREVIEW_UNLOCK;

// Diagram mapping, computed here (not inline in the template) so the
// client:visible directive below binds to a real, statically-analyzable
// component reference. Best-effort and not yet exercised by any real v4.1
// app — Dave has no system.html entry, so app.system is null and none of
// this runs. Kept minimal and defensive rather than reusing systemProps(),
// which assumes the v3 `mechanics` shape (dominantCategory() there iterates
// app.mechanics, which v4.1 apps don't have).
const systemNodes = app.system
  ? app.system.nodes.map((n: any) => {
      const mechanic = mechanicsById.get(n.id);
      return {
        id: n.id,
        x: n.x,
        y: n.y,
        label: mechanic?.name ?? n.id,
        category: mechanic?.cat ?? "retention",
        // "#" is the pre-existing, untouched fallback for no mechanics-
        // collection entry at all — mechanicHref() only runs once one exists.
        href: mechanic ? mechanicHref(mechanic.id, mechanic.visibility) : "#",
        spine: false,
      };
    })
  : [];
const systemById = Object.fromEntries(systemNodes.map((n: any) => [n.id, n]));
const systemConnections = app.system
  ? app.system.connections.map((c: any) => ({ from: c.from, to: c.to, type: "mechanic", label: c.title }))
  : [];

const mechanicBlocks = tagBlocks(app, mechanicsById);
const sections = allSectionCounts(app);
---

<div class="container">
  {locked ? (
    <div class="container--narrow">
      <header class="cs-hd" id="overview">
        <nav class="crumb" aria-label="Breadcrumb">
          <a href="/case-studies/">Case studies</a>
          <span class="crumb__sep" aria-hidden="true">/</span>
          <span>{app.name}</span>
          <span class="crumb__sep" aria-hidden="true">/</span>
          <span>Full breakdown</span>
        </nav>
        <div class="cs-hd__row">
          {app.icon ? (
            <div class="cs-hd__icon" aria-hidden="true"><img src={app.icon} alt="" style="width:100%;height:100%;object-fit:cover;" /></div>
          ) : (
            <div class="cs-hd__icon" aria-hidden="true">{initials(app.name)}</div>
          )}
          <div class="cs-hd__heads">
            <Tag category="neutral" variant="outline">{app.category}</Tag>
            <h1 class="cs-hd__title">{app.name} {"—"} Full Breakdown</h1>
          </div>
          <div class="cs-hd__meta">
            <div class="cs-hd__meta-observed">{formatMonthYear(app.asObserved)}</div>
            {app.appVersion && <div class="cs-hd__meta-version">App version {app.appVersion}</div>}
          </div>
        </div>
        <p class="cs-hd__overview">{app.summary}</p>
      </header>

      <div class="cs-gate">
        <div class="cs-gate__lead">
          <div class="eyebrow">Subscribers only</div>
          <h2 class="cs-gate__h">Read the full {app.name} breakdown</h2>
          <p class="cs-gate__p">The complete case study walks every observation behind each mechanic, with the system view and the full record of every section. Subscribe to unlock this and every other breakdown in the library.</p>
        </div>
        <GateWidget client:load />
      </div>
    </div>
  ) : (
    <div class="cs-layout">
      <aside class="cs-toc" aria-label="On this page">
        <a class="cs-toc__back" href="/case-studies/">{"←"} All case studies</a>
        <div class="cs-toc__label">On this page</div>
        <nav class="cs-toc__nav">
          <a class="cs-toc__link" href="#system-view">System view</a>
          <a class="cs-toc__link" href="#mechanics">Mechanics</a>
          {mechanicBlocks.map((block) => (
            <a class="cs-toc__link cs-toc__link--sub" href={`#mechanic-${block.mechanicId}`}>{block.name}</a>
          ))}
          <a class="cs-toc__link" href="#full-record">The full record</a>
        </nav>
      </aside>

      <div class="v41-cs-body">
        <header class="cs-hd" id="overview">
          <nav class="crumb" aria-label="Breadcrumb">
            <a href="/case-studies/">Case studies</a>
            <span class="crumb__sep" aria-hidden="true">/</span>
            <span>{app.name}</span>
            <span class="crumb__sep" aria-hidden="true">/</span>
            <span>Full breakdown</span>
          </nav>
          <div class="cs-hd__row">
            {app.icon ? (
              <div class="cs-hd__icon" aria-hidden="true"><img src={app.icon} alt="" style="width:100%;height:100%;object-fit:cover;" /></div>
            ) : (
              <div class="cs-hd__icon" aria-hidden="true">{initials(app.name)}</div>
            )}
            <div class="cs-hd__heads">
              <Tag category="neutral" variant="outline">{app.category}</Tag>
              <h1 class="cs-hd__title">{app.name} {"—"} Full Breakdown</h1>
            </div>
            {/* Header metadata (spec review, 11 Sep 2026): quiet, top-right,
                aligned with the title row rather than competing with it —
                reuses .feed__date's own recipe (mono, 12px, muted) rather
                than a new style. App version only renders when the analysis
                states one; "None" in the source means nothing renders, not
                a placeholder. */}
            <div class="cs-hd__meta">
              <div class="cs-hd__meta-observed">{formatMonthYear(app.asObserved)}</div>
              {app.appVersion && <div class="cs-hd__meta-version">App version {app.appVersion}</div>}
            </div>
          </div>
          <p class="cs-hd__overview">{app.summary}</p>
        </header>

        {/* 1. System view — one short paragraph (spec §2.1, revised 11 Sep
            2026): how complex the system is and the spine it hangs from,
            then a link through to the systems page, where the diagram and
            the full account live. This page no longer carries the full
            system narrative — a wall of text with no diagram was the
            systems page done badly. Kicker + .mech-section__title stay,
            exactly as v3's own top-level sections pair them. */}
        <section class="v41-cs-systemview" id="system-view" aria-label="System view">
          <div class="mech-section__kicker">System view</div>
          <h2 class="mech-section__title">How the app fits together</h2>
          <div class="mech-prose">
            {(app.systemView ?? []).map((p: string) => <p>{p}</p>)}
          </div>
          <a class="cs-msec__link" href={`/systems/${app.id}/`}>
            See the full system view
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline>
            </svg>
          </a>
          {app.system && (
            <div class="v41-cs-diagram">
              <SystemMap client:visible nodes={systemNodes} connections={systemConnections} byId={systemById} />
            </div>
          )}
        </section>

        {/* 2. Mechanics — the mechanics-observed chip row first (.cs-chips,
            one per applied tag, linking down to its block), then one .cs-msec
            block per tag, each paired with a .gb-tag category chip beside its
            heading — both exactly as v3 does. A tag with no reference page
            yet (Earning Tasks, Referral Boost) renders under the neutral
            category rather than guessing one. Each block's body is the
            composed write-up (spec §2.1, revised 11 Sep 2026), not the
            tagged observations — those still exist on the block for the tag
            index to use later, but this page no longer renders them. */}
        <section class="v41-cs-mechanics" id="mechanics" aria-label="Mechanics">
          <div class="mech-section__kicker">Mechanics</div>
          <h2 class="mech-section__title">Where the patterns show up</h2>
          <div class="cs-chips">
            {mechanicBlocks.map((block) => {
              const cat = block.mechanic?.cat ?? "neutral";
              return (
                <a class="cs-chip" href={`#mechanic-${block.mechanicId}`}>
                  <span class="cs-chip__dot" style={`background:${CAT_COLOR[cat]}`} />
                  <span class="cs-chip__name">{block.name}</span>
                  <span class="cs-chip__cat">{CAT_LABEL[cat]}</span>
                </a>
              );
            })}
          </div>
          {mechanicBlocks.map((block) => {
            const cat = block.mechanic?.cat ?? "neutral";
            const fullPageHref = block.mechanic ? mechanicHref(block.mechanic.id, block.mechanic.visibility) : null;
            return (
              <div class="cs-msec" id={`mechanic-${block.mechanicId}`}>
                <div class="cs-msec__head">
                  <div class="cs-msec__meta">
                    <Tag category={cat} dot>{CAT_LABEL[cat]}</Tag>
                    <h2 class="cs-msec__name">{block.name}</h2>
                  </div>
                  {fullPageHref && (
                    <a class="cs-msec__link" href={fullPageHref}>
                      Full mechanic page
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline>
                      </svg>
                    </a>
                  )}
                </div>
                <div class="cs-msec__body">
                  {block.writeup?.observed && (
                    <div class="cs-sub">
                      <h3 class="cs-sub__h">What was observed</h3>
                      <p>{block.writeup.observed}</p>
                    </div>
                  )}
                  {block.writeup?.presented && (
                    <div class="cs-sub">
                      <h3 class="cs-sub__h">How it is presented</h3>
                      <p>{block.writeup.presented}</p>
                    </div>
                  )}
                  {block.writeup?.noting && (
                    <div class="cs-sub">
                      <h3 class="cs-sub__h">What is worth noting</h3>
                      <p>{block.writeup.noting}</p>
                    </div>
                  )}
                  {block.writeup?.findings && block.writeup.findings.length > 0 && (
                    <div class="cs-sub">
                      <h3 class="cs-sub__h">Key findings</h3>
                      <ul class="cs-findings">
                        {block.writeup.findings.map((f: string) => <li>{f}</li>)}
                      </ul>
                    </div>
                  )}
                </div>
              </div>
            );
          })}
        </section>

        {/* 3. The full record — nine section cards, name and a one-line
            description only (spec §2.1: "16 observations" is internal
            vocabulary a reader doesn't know). Empty ones are shown as such
            and stay unlinked. */}
        <section class="v41-cs-record" id="full-record" aria-label="The full record">
          <div class="mech-section__kicker">The full record</div>
          <h2 class="mech-section__title">Every section, in full</h2>
          <div class="v41-record-cards">
            {sections.map((s) => (
              s.count > 0 ? (
                <a class="v41-record-card" href={`/case-studies/${app.id}/${s.slug}/`}>
                  <h3>{s.name}</h3>
                  <p>{app.sectionCards?.[s.slug] ?? ""}</p>
                </a>
              ) : (
                <div class="v41-record-card v41-record-card--empty">
                  <h3>{s.name}</h3>
                  <p>{app.sectionCards?.[s.slug] ?? ""}</p>
                  <span>Nothing observed here</span>
                </div>
              )
            ))}
          </div>
        </section>
      </div>
    </div>
  )}
</div>
