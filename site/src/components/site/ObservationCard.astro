---
/**
 * One observation, rendered in full (spec §2.3). Used identically by a
 * section page (every observation in that section) and by a mechanic block
 * on the summary page (just the observations carrying that tag) — same
 * component, same output, deliberately appearing twice per spec §2.3.
 *
 * No tag chips render here — the mechanic name is already the heading of
 * its block, so repeating it on every observation inside that block was
 * redundant, and it was the only thing under a mechanic's own observations
 * saying "this one has a tag" when every observation there already has one
 * by definition. Tags stay in the data; nothing here reads them for display,
 * only `boxed` cares whether an observation is tagged at all.
 *
 * `boxed` (default true) controls whether an observation gets the
 * tinted-box weight treatment: true on a section page, where tagged and
 * untagged observations are mixed and the box is what tells a reader "this
 * one connects to a named pattern"; false inside a mechanic block, where
 * every observation is tagged by definition and boxing each one turned the
 * block into a stack of tiles instead of one piece of writing. Screenshots
 * still switch to a two-column layout regardless of context, and short/long
 * observations still get tighter or looser vertical spacing — those are
 * about density, not about flagging a tag.
 */
interface Props {
  observation: {
    id: string;
    name: string;
    observed: string;
    detail: string[];
    tags: { name: string; confidence: string }[];
    screenshots: { src: string; caption: string | null }[];
  };
  boxed?: boolean;
}

const { observation, boxed = true } = Astro.props as Props;

const hasTags = observation.tags.length > 0;
const hasShots = observation.screenshots.length > 0;

// Rhythm: short observations (little prose, at most one supporting point)
// sit tighter than long ones. Computed once per observation from its own
// content, not styled by hand — this is what keeps a 26-observation page
// from reading as one undifferentiated block.
const wordCount =
  observation.observed.split(/\s+/).filter(Boolean).length +
  observation.detail.join(" ").split(/\s+/).filter(Boolean).length;
const density = wordCount < 30 && observation.detail.length <= 1 ? "short" : wordCount > 90 || observation.detail.length >= 5 ? "long" : "regular";
---

<article
  id={observation.id}
  class:list={[
    "v41-observation",
    `v41-observation--${density}`,
    boxed && hasTags && "v41-observation--tagged",
    hasShots && "v41-observation--shots",
    !boxed && "v41-observation--flow",
  ]}
>
  <div class="v41-observation__body">
    <div class="v41-observation__text">
      <h3 class="v41-observation__title">{observation.name}</h3>
      <p class="v41-observation__observed">{observation.observed}</p>

      {observation.detail.length > 0 && (
        <ul class="cs-findings v41-observation__detail">
          {observation.detail.map((d) => <li>{d}</li>)}
        </ul>
      )}
    </div>

    {hasShots && (
      <div class="shotgallery shotgallery--real v41-observation__shots">
        {observation.screenshots.map((s) => (
          <figure class="shot shot--real">
            <img class="shot__img" src={s.src} alt={s.caption ?? ""} />
            {s.caption && <figcaption class="shot__cap">{s.caption}</figcaption>}
          </figure>
        ))}
      </div>
    )}
  </div>
</article>
