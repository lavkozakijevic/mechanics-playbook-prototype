---
import Base from "../../layouts/Base.astro";
---

<Base
  title="Log in — Mechanics Playbook"
  description="Sign in to your Mechanics Playbook account."
>
  <main id="main">
    <section class="band lib-head" style="padding-block:clamp(48px,6vw,80px)">
      <div class="container" style="max-width:480px">
        <h1>Log in</h1>
        <p style="font:var(--type-body-lg);color:var(--text-secondary);margin-bottom:32px">
          Subscriber login is coming soon. <a href="mailto:hello@gamebiz.co">Contact us</a> if you need access.
        </p>
        <p style="font:var(--type-body-sm);color:var(--text-muted)">
          Not a subscriber yet? <a href="/subscribe/">See subscription options →</a>
        </p>
      </div>
    </section>
  </main>
</Base>
