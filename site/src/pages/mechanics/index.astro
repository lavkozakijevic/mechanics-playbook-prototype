---
import Base from "../../layouts/Base.astro";
import { MechanicsFilters } from "../../components/site/MechanicsLibrary.jsx";
import { publishedApps, publishedMechanics, titleCase } from "../../lib/content";
import { mechanicCard, initials, EXAMPLE_EXCLUDED } from "../../lib/props";
import { tagBlocks } from "../../lib/v41";
import { PREVIEW_UNLOCK } from "../../lib/preview";

const mechanics = await publishedMechanics();
const apps = await publishedApps();
const mechanicsById = new Map(mechanics.map((m) => [m.data.id, m.data]));

// Rebuilt on tags/implementations (spec §3): a row per mechanic, a card per
// app that applies it as a real tag, sourced from tagBlocks() rather than
// the old flat `mechanics: [{id}]` array. v3 apps contribute nothing here
// (owner decision, 14 Sep 2026) — their write-ups carry no per-tag role
// text, only a depth tier, and standing in a depth tier for a role would
// misrepresent what "role" means for an actually-analysed implementation.
// This is the same exclusion tagBlocks() itself already applies (v3 apps
// carry no `observations`), just made deliberate here rather than
// incidental. It clears as each app is re-analysed under the current model.
//
// Also excludes EXAMPLE_EXCLUDED (owner ruling, 17 Jun 2026 — Cleo, Acorns,
// and three finance apps not yet in this collection at all): the same bar
// mechanicStudies() already applies on a mechanic's own detail page, so a
// barred app can't surface here either, one row-per-app-implementation at a
// time, as an end run around a rule written for the one-example-per-app
// list. check-report-leak.mjs's Example-block guard checks for exactly this.
const v41Apps = apps.filter((a) => a.data.contentFormat === "v4.1" && !EXAMPLE_EXCLUDED.has(a.data.id));

interface Card {
  appId: string;
  appName: string;
  appIcon: string | null;
  role: string;
  roleTokens: string[];
  locked: boolean;
  mechanicId: string;
}

// Role is a property of the implementation, not the mechanic (owner
// correction, 14 Sep 2026) — it lives on the card, one per (app, applied
// tag) pair, never rolled up onto the row. Two different library entries
// resolving to the same site mechanic in the same app (the merged-taxonomy
// case, e.g. Leaderboard and Comparative Rank both landing on
// `leaderboards`) still get two separate cards here, same as they get two
// separate blocks on that app's own summary page — not a mistake to fold
// together (v41.ts).
const cardsByMechanic = new Map<string, Card[]>();
for (const app of v41Apps) {
  const blocks = tagBlocks(app.data, mechanicsById);
  // Declared visibility, not REVIEW_WINDOW_OPEN (owner instruction, 14 Sep
  // 2026) — reads the same already-resolved `app.data.visibility` field
  // CaseStudySummaryV41.astro/CaseStudySectionV41.astro gate on, rather than
  // importing REVIEW_WINDOW_OPEN a second time and re-deriving it here.
  // PREVIEW_UNLOCK kept for the same reason those two do: a local-preview-
  // only override, off by default, that would otherwise leave this index
  // locked while the case study it links to is unlocked.
  const locked = app.data.visibility !== "public" && !PREVIEW_UNLOCK;
  for (const block of blocks) {
    if (!block.mechanic) continue; // no resolved site mechanic — no row to index it under
    const list = cardsByMechanic.get(block.mechanic.id) ?? [];
    list.push({
      appId: app.data.id,
      appName: app.data.name,
      appIcon: app.data.icon ?? null,
      role: block.role || "",
      // Role text is free prose ("engagement, retention.", "monetization,
      // engagement") drawn from exactly four vocabulary words shared with
      // `cat` — tokenized here only for the filter's own matching, never
      // for display (the card still shows the source string as written).
      roleTokens: [...new Set(
        (block.role || "")
          .toLowerCase()
          .replace(/\./g, "")
          .split(",")
          .map((s) => s.trim())
          .filter(Boolean)
      )],
      locked,
      mechanicId: block.mechanicId,
    });
    cardsByMechanic.set(block.mechanic.id, list);
  }
}

const ROLE_OPTIONS = ["engagement", "retention", "monetization", "social"];

// Tag rows alphabetical by name; cards within a row app-alphabetical
// (owner answers, 14 Sep 2026) — neither reuses the old index's number-
// ordered (`n`) card order, which was about the library's own reading
// order, not a reader scanning for a specific mechanic or app by name.
const rows = mechanics
  .map((m) => {
    const cards = (cardsByMechanic.get(m.data.id) ?? []).sort((a, b) => a.appName.localeCompare(b.appName));
    return { card: mechanicCard(m.data, cards.length), cat: m.data.cat, cards };
  })
  .sort((a, b) => a.card.name.localeCompare(b.card.name));

const contextOptions = [...new Set(mechanics.flatMap((m) => m.data.context ?? []))].map(titleCase);
const playerOptions = [...new Set(mechanics.flatMap((m) => m.data.players ?? []))];

const CATS: Record<string, { label: string; color: string }> = {
  retention:    { label: "Retention",    color: "var(--cat-retention)" },
  monetization: { label: "Monetization", color: "var(--cat-monetization)" },
  social:       { label: "Social",       color: "var(--cat-social)" },
};
const ROLE_LABEL: Record<string, string> = {
  engagement: "Engagement",
  retention: "Retention",
  monetization: "Monetization",
  social: "Social",
};
---

<Base
  title="Mechanics library — Appservatory"
  description="The mechanics that drive retention, monetization, and social engagement — each defined plainly, with the psychology behind it and real apps that use it."
  current="mechanics"
>
  <main id="main">
    <section class="band--tight lib-head">
      <div class="container">
        <div class="eyebrow lib-head__eyebrow">The library</div>
        <h1>Mechanics library</h1>
        <p>The building blocks behind the apps and games people keep coming back to. Each mechanic comes with its psychology, the users it fits, and real examples from the library.</p>
      </div>
    </section>

    <div class="container">
      <div class="mechanics-layout">
        <aside class="lib-filters">
          <!-- React island: filter controls only — no row/card rendering -->
          <MechanicsFilters
            client:load
            contextOptions={contextOptions}
            playerOptions={playerOptions}
            roleOptions={ROLE_OPTIONS}
            total={rows.length}
          />
        </aside>

        <section aria-label="Mechanics">
          <div class="lib-resultbar">
            <span class="lib-resultbar__count">
              <b id="lib-shown">{rows.length}</b> of {rows.length} mechanics
            </span>
            <span id="lib-hint" class="lib-resultbar__hint">Updated weekly</span>
            <button type="button" id="lib-reset" class="filters__clear" hidden>Reset filters</button>
          </div>

          <!--
            Every row and card is rendered here by Astro at build time —
            JavaScript is layered on top only for show/hide filtering
            (data-tag-row for a row's own search/category/context/player
            match, data-roles on each card for the role filter, which hides
            cards individually and then hides a row left with none visible).
          -->
          <div class="tag-rows" id="tag-rows">
            {rows.map(({ card, cat, cards }) => {
              const RowTag = card.href ? "a" : "span";
              return (
                <div
                  class="tag-row"
                  data-tag-row={card.id}
                  data-cat={cat}
                  data-contexts={JSON.stringify(card.contextTags ?? [])}
                  data-players={JSON.stringify(card.players ?? [])}
                  data-name={card.name.toLowerCase()}
                  data-def={card.definition.toLowerCase()}
                >
                  <div class="tag-row__head">
                    <span class="tag-row__lead">
                      <span class="tag-row__num">{String(card.n).padStart(2, "0")}</span>
                      <span class:list={["gb-tag", `gb-tag--${cat}`]}>{CATS[cat]?.label ?? cat}</span>
                    </span>
                    <RowTag class:list={["tag-row__name", !card.href && "tag-row__name--locked"]} href={card.href || undefined}>
                      {card.name}
                    </RowTag>
                    <span class="tag-row__count">{cards.length} {cards.length === 1 ? "implementation" : "implementations"}</span>
                  </div>
                  <p class="tag-row__def">{card.definition}</p>

                  {cards.length > 0 ? (
                    <div class="tag-row__cards">
                      {cards.map((c) => (
                        <a
                          class:list={["csc", "csc--impl", c.locked && "csc--locked"]}
                          href={c.locked ? "/subscribe/" : `/case-studies/${c.appId}/#mechanic-${c.mechanicId}`}
                          data-role-card
                          data-roles={JSON.stringify(c.roleTokens)}
                        >
                          <div class="csc__head">
                            {c.appIcon ? (
                              <div class="csc__icon" aria-hidden="true"><img src={c.appIcon} alt="" style="width:100%;height:100%;object-fit:cover;" /></div>
                            ) : (
                              <div class="csc__icon" aria-hidden="true">{initials(c.appName)}</div>
                            )}
                            <h3 class="csc__name">{c.appName}</h3>
                          </div>
                          {c.role && (
                            <div class="csc__tags">
                              {c.roleTokens.map((r) => <span class="pillchip">{ROLE_LABEL[r] ?? titleCase(r)}</span>)}
                            </div>
                          )}
                          <div class="csc__foot">
                            <span class="csc__go">{c.locked ? "Subscribe to explore" : "View in context"}</span>
                          </div>
                        </a>
                      ))}
                    </div>
                  ) : (
                    <p class="tag-row__empty">No implementations to show under the current model yet.</p>
                  )}
                </div>
              );
            })}
          </div>

          <div class="lib-empty" id="lib-empty" hidden>No mechanics match those filters. Try removing one.</div>
        </section>
      </div>
    </div>
  </main>
</Base>
