---
import Base from "../../layouts/Base.astro";
import { MechanicsFilters } from "../../components/site/MechanicsLibrary.jsx";
import { publishedApps, publishedMechanics } from "../../lib/content";
import { mechanicCard, initials, EXAMPLE_EXCLUDED } from "../../lib/props";
import { tagBlocks } from "../../lib/v41";

const mechanics = await publishedMechanics();
const apps = await publishedApps();
const mechanicsById = new Map(mechanics.map((m) => [m.data.id, m.data]));

// Rebuilt as pills-and-reveal (spec §3 rebuild, 16 Sep 2026): a pill per
// mechanic with at least one implementation, nothing below until one is
// tapped. v3 apps contribute nothing here (owner decision, 14 Sep 2026) —
// their write-ups carry no per-tag role text or implementation summary,
// only a depth tier, and standing a depth tier in for either would
// misrepresent an actually-analysed implementation. This clears as each
// app is re-analysed under the current model.
//
// Also excludes EXAMPLE_EXCLUDED (owner ruling, 17 Jun 2026 — Cleo, Acorns,
// and three finance apps not yet in this collection at all): the same bar
// mechanicStudies() already applies on a mechanic's own detail page, so a
// barred app can't surface here either. check-report-leak.mjs's
// Example-block guard checks for exactly this.
const v41Apps = apps.filter((a) => a.data.contentFormat === "v4.1" && !EXAMPLE_EXCLUDED.has(a.data.id));

interface Card {
  appId: string;
  appName: string;
  appIcon: string | null;
  summary: string | undefined;
  roleTokens: string[];
  mechanicId: string;
  locked: boolean;
}

// Role is a property of the implementation, not the mechanic — kept only
// as filter data now (owner instruction, 16 Sep 2026: the card itself no
// longer displays it, the implementation summary carries the distinguishing
// detail instead). Two different library entries resolving to the same
// site mechanic in the same app (the merged-taxonomy case, e.g.
// Leaderboard and Comparative Rank both landing on `leaderboards`) still
// get two separate cards here, same as they get two separate blocks on
// that app's own summary page — not a mistake to fold together (v41.ts).
const cardsByMechanic = new Map<string, Omit<Card, "locked">[]>();
for (const app of v41Apps) {
  const blocks = tagBlocks(app.data, mechanicsById);
  for (const block of blocks) {
    if (!block.mechanic) continue; // no resolved site mechanic — nothing to index it under
    const list = cardsByMechanic.get(block.mechanic.id) ?? [];
    list.push({
      appId: app.data.id,
      appName: app.data.name,
      appIcon: app.data.icon ?? null,
      summary: block.writeup?.summary,
      roleTokens: [...new Set(
        (block.role || "")
          .toLowerCase()
          .replace(/\./g, "")
          .split(",")
          .map((s) => s.trim())
          .filter(Boolean)
      )],
      mechanicId: block.mechanicId,
    });
    cardsByMechanic.set(block.mechanic.id, list);
  }
}

const ROLE_OPTIONS = ["engagement", "retention", "monetization", "social"];

// Pills alphabetical by mechanic name; cards within a pill app-alphabetical
// (owner answers, 14 Sep 2026). "First" for locking purposes (spec §3.3)
// means first in this same app-alphabetical order — no curation field, so
// list order is the only content decision here, same as the spec's own
// "first in the list" reading.
//
// A mechanic with zero implementations gets no pill at all (spec §3.0: "not
// as an empty tag, not as a disabled one" — a permanent rule, not a
// migration workaround). Locking is positional (spec §3.3: "the first is
// open, the rest are locked"), not app-visibility-based — the earlier build
// of this page locked by `app.data.visibility`, which this rebuild
// corrects; a mechanic's index card is about what the library is willing
// to show for free on this page, not about what's public elsewhere on the
// site.
const pills = mechanics
  .map((m) => {
    const sorted = (cardsByMechanic.get(m.data.id) ?? []).sort((a, b) => a.appName.localeCompare(b.appName));
    const cards: Card[] = sorted.map((c, i) => ({ ...c, locked: i > 0 }));
    return { card: mechanicCard(m.data, cards.length), cat: m.data.cat, cards };
  })
  .filter((p) => p.cards.length > 0)
  .sort((a, b) => a.card.name.localeCompare(b.card.name));

const playerOptions = [...new Set(mechanics.flatMap((m) => m.data.players ?? []))];

---

<Base
  title="Mechanics library — Appservatory"
  description="The mechanics that drive retention, monetization, and social engagement — each defined plainly, with the psychology behind it and real apps that use it."
  current="mechanics"
>
  <main id="main">
    <section class="band--tight lib-head">
      <div class="container">
        <div class="eyebrow lib-head__eyebrow">The library</div>
        <h1>Mechanics library</h1>
        <p>The building blocks behind the apps and games people keep coming back to. Each mechanic comes with its psychology, the users it fits, and real examples from the library.</p>
      </div>
    </section>

    <div class="container">
      <div class="mechanics-layout">
        <aside class="lib-filters">
          <!-- React island: filter controls and pill selection only — no
               row/card content rendering; everything below is Astro output
               at build time, this island only toggles `hidden`. -->
          <MechanicsFilters
            client:load
            playerOptions={playerOptions}
            roleOptions={ROLE_OPTIONS}
            total={pills.length}
          />
        </aside>

        <section aria-label="Mechanics">
          <div class="lib-resultbar">
            <span class="lib-resultbar__count">
              <b id="lib-shown">{pills.length}</b> of {pills.length} mechanics
            </span>
            <span id="lib-hint" class="lib-resultbar__hint">Updated weekly</span>
            <button type="button" id="lib-reset" class="filters__clear" hidden>Reset filters</button>
          </div>

          <!--
            Pills across the top (spec §3.1), one per mechanic with at
            least one implementation, alphabetical. A button, not a link —
            it toggles which card grid below is visible rather than
            navigating anywhere (spec §3 rebuild, 16 Sep 2026: the earlier
            build's row heading linked to the mechanic's own reference
            page; pills don't carry that link at all now, held-back or
            not — see the plan note on spec §3.6). data-search carries the
            mechanic's name, definition, and every one of its cards'
            implementation summaries, lowercased, for the search filter
            (spec §3.4: "implementation content").
          -->
          <div class="mech-pills" id="mech-pills" role="group" aria-label="Mechanics">
            {pills.map(({ card, cat, cards }) => (
              <button
                type="button"
                class="mech-pill"
                data-pill={card.id}
                data-cat={cat}
                data-players={JSON.stringify(card.players ?? [])}
                data-search={[card.name, card.definition, ...cards.map((c) => c.summary ?? "")].join(" ").toLowerCase()}
                aria-pressed="false"
              >
                {card.name}
              </button>
            ))}
          </div>

          <!--
            Landing state (spec §3.2, rewritten 16 Sep 2026): no card, no
            default selection — just this one line, replaced by the
            selected mechanic's card grid the moment a pill is tapped.
          -->
          <p class="mech-empty" id="mech-empty">Pick a mechanic to see how apps use it.</p>

          <!--
            One grid per pill, all rendered here at build time, all hidden
            until their pill is tapped — the same "Astro renders
            everything, JS only shows/hides" discipline the filters
            already use. Role filters cards inside whichever grid is
            currently visible (spec §3.4); since every other grid stays
            hidden regardless, there's no need to scope that filtering to
            "only the open one" in code — hidden cards filtering
            internally has no visible effect.
          -->
          <div id="mech-grids">
            {pills.map(({ card, cards }) => (
              <div class="mech-cards" data-mech-cards={card.id} hidden>
                {cards.map((c) => (
                  c.locked ? (
                    <div class="csc csc--impl csc--locked-strict" data-role-card data-roles={JSON.stringify(c.roleTokens)}>
                      <div class="csc__head">
                        {c.appIcon ? (
                          <div class="csc__icon" aria-hidden="true"><img src={c.appIcon} alt="" style="width:100%;height:100%;object-fit:cover;" /></div>
                        ) : (
                          <div class="csc__icon" aria-hidden="true">{initials(c.appName)}</div>
                        )}
                        <h3 class="csc__name">{c.appName}</h3>
                      </div>
                      {c.summary && <p class="csc__desc">{c.summary}</p>}
                      <div class="csc__foot">
                        <a class="csc__go" href="/subscribe/">Subscribe to see this in context</a>
                      </div>
                    </div>
                  ) : (
                    <a
                      class="csc csc--impl"
                      href={`/case-studies/${c.appId}/#mechanic-${c.mechanicId}`}
                      data-role-card
                      data-roles={JSON.stringify(c.roleTokens)}
                    >
                      <div class="csc__head">
                        {c.appIcon ? (
                          <div class="csc__icon" aria-hidden="true"><img src={c.appIcon} alt="" style="width:100%;height:100%;object-fit:cover;" /></div>
                        ) : (
                          <div class="csc__icon" aria-hidden="true">{initials(c.appName)}</div>
                        )}
                        <h3 class="csc__name">{c.appName}</h3>
                      </div>
                      {c.summary && <p class="csc__desc">{c.summary}</p>}
                      <div class="csc__foot">
                        <span class="csc__go">View in context</span>
                      </div>
                    </a>
                  )
                ))}
              </div>
            ))}
          </div>

          <div class="lib-empty" id="lib-empty" hidden>No mechanics match those filters. Try removing one.</div>
        </section>
      </div>
    </div>
  </main>
</Base>
