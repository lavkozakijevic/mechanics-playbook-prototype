---
import Base from "../../layouts/Base.astro";
import { MechanicDetailPage } from "../../components/site/MechanicDetail.jsx";
import { publishedApps, publishedMechanics, HELD_BACK_MECHANIC_IDS, mechanicHref } from "../../lib/content";
import { mechanicDetailProps, mechanicStudies } from "../../lib/props";

// A held-back mechanic (the eight merges, sources/taxonomy-map.md) gets no
// page of its own — publishing one would assert a taxonomy the library has
// moved past, independent of its own declared visibility (all eight are
// declared "public") and of REVIEW_WINDOW_OPEN. It still exists in the
// mechanics collection (so other pages can reference its name/category),
// it just isn't one of the static paths built here, in either window state.
export async function getStaticPaths() {
  return (await publishedMechanics())
    .filter((mech) => !HELD_BACK_MECHANIC_IDS.has(mech.data.id))
    .map((mech) => ({ params: { id: mech.data.id }, props: { mech } }));
}

const { mech } = Astro.props;
const byId = new Map((await publishedMechanics()).map((m) => [m.data.id, m.data]));
const apps = (await publishedApps()).map((a) => a.data);

const props = mechanicDetailProps(mech.data);
// Resolve paired mechanic names from the library. A held-back mechanic still
// shows in this list (the relationship is real), just unlinked — same
// "no reference page" fallback used elsewhere (sources/taxonomy-map.md).
const pairedWith = props.pairedWith
  .map(({ id }) => {
    const p = byId.get(id);
    return p ? { name: p.name, cat: p.cat, href: mechanicHref(id, p.visibility) } : null;
  })
  .filter(Boolean);
const studies = mechanicStudies(mech.data.id, apps);
---

<Base
  title={`${mech.data.name} — mechanic — Appservatory`}
  description={mech.data.tagline.slice(0, 155)}
  current="mechanics"
>
  <MechanicDetailPage mech={{ ...props, pairedWith }} studies={studies} />
</Base>
