---
import Base from "../../layouts/Base.astro";
import { CaseStudyDetailPage } from "../../components/site/CaseStudyDetail.jsx";
import CaseStudySummaryV41 from "../../components/site/CaseStudySummaryV41.astro";
import { publishedApps, publishedMechanics } from "../../lib/content";
import { caseStudyProps } from "../../lib/props";
import { isFreeApp } from "../../lib/gate-data.mjs";

// Only FREE apps (strava, and the rotating free slot) are built as static pages:
// they are public, so a file is right. Every other case study is rendered on
// request by case-studies/[...rest].astro after an entitlement check, and is
// never written to a file. Astro matches the more specific route first and, in
// the Worker, falls through to [...rest] for a path this one has no page for.
export async function getStaticPaths() {
  return (await publishedApps())
    .filter((app) => isFreeApp(app.data))
    .map((app) => ({ params: { id: app.data.id }, props: { app } }));
}

const { app } = Astro.props;
const mechanics = await publishedMechanics();
const byId = new Map(mechanics.map((m) => [m.data.id, m.data]));
---

<Base
  title={`${app.data.name} — case study — Appservatory`}
  description={app.data.summary.slice(0, 155)}
  current="case-studies"
>
  {app.data.contentFormat === "v4.1" ? (
    <CaseStudySummaryV41 app={app.data} mechanicsById={byId} />
  ) : (
    <CaseStudyDetailPage client:load app={caseStudyProps(app.data, byId)} locked={false} />
  )}
</Base>
