---
import Base from "../../layouts/Base.astro";
import { CaseStudyDetailPage } from "../../components/site/CaseStudyDetail.jsx";
import CaseStudySummaryV41 from "../../components/site/CaseStudySummaryV41.astro";
import { publishedApps, publishedMechanics } from "../../lib/content";
import { caseStudyProps } from "../../lib/props";

export async function getStaticPaths() {
  return (await publishedApps()).map((app) => ({ params: { id: app.data.id }, props: { app } }));
}

const { app } = Astro.props;
const mechanics = await publishedMechanics();
const byId = new Map(mechanics.map((m) => [m.data.id, m.data]));
---

<Base
  title={`${app.data.name} — case study — Appservatory`}
  description={app.data.summary.slice(0, 155)}
  current="case-studies"
>
  {app.data.contentFormat === "v4.1" ? (
    <CaseStudySummaryV41 app={app.data} mechanicsById={byId} />
  ) : (
    <CaseStudyDetailPage client:load app={caseStudyProps(app.data, byId)} locked={app.data.visibility !== "public"} />
  )}
</Base>
