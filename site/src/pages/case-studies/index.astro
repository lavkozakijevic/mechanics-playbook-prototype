---
import Base from "../../layouts/Base.astro";
import { CaseStudiesPage } from "../../components/site/CaseStudies.jsx";
import { publishedApps, publishedMechanics } from "../../lib/content";
import { appCard } from "../../lib/props";

const apps = (await publishedApps()).sort(
  (a, b) => (b.data.analysisDate ?? "").localeCompare(a.data.analysisDate ?? "")
);
const byId = new Map((await publishedMechanics()).map((m) => [m.data.id, m.data]));
---

<Base
  title="Case studies — Mechanics Playbook"
  description="Every app and game in the library, broken down mechanic by mechanic: what it runs, how it presents it, and why it works."
  current="case-studies"
>
  <CaseStudiesPage apps={apps.map((a) => appCard(a.data, byId))} />
</Base>
