---
import Base from "../../layouts/Base.astro";
import { CaseStudiesPage } from "../../components/site/CaseStudies.jsx";
import { publishedApps, publishedMechanics } from "../../lib/content";
import { appCard } from "../../lib/props";
import { SITE_TAGLINE } from "../../lib/site-copy";

const apps = (await publishedApps()).sort((a, b) => {
  const aFree = a.data.visibility !== "subscriber" ? 0 : 1;
  const bFree = b.data.visibility !== "subscriber" ? 0 : 1;
  if (aFree !== bFree) return aFree - bFree;
  return (b.data.analysisDate ?? "").localeCompare(a.data.analysisDate ?? "");
});
const byId = new Map((await publishedMechanics()).map((m) => [m.data.id, m.data]));
---

<Base
  title="Case studies — Appservatory"
  description={`${SITE_TAGLINE}.`}
  current="case-studies"
>
  <CaseStudiesPage apps={apps.map((a) => appCard(a.data, byId))} />
</Base>
