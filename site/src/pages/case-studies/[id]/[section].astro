---
import Base from "../../../layouts/Base.astro";
import CaseStudySectionV41 from "../../../components/site/CaseStudySectionV41.astro";
import { publishedApps, publishedMechanics } from "../../../lib/content";
import { nonEmptySections } from "../../../lib/v41";

export async function getStaticPaths() {
  const apps = (await publishedApps()).filter((a) => a.data.contentFormat === "v4.1");
  return apps.flatMap((app) =>
    nonEmptySections(app.data).map((s) => ({
      params: { id: app.data.id, section: s.slug },
      props: { app, section: s.slug },
    }))
  );
}

const { app, section } = Astro.props;
const byId = new Map((await publishedMechanics()).map((m) => [m.data.id, m.data]));
const sectionName = nonEmptySections(app.data).find((s) => s.slug === section)?.name ?? section;
---

<Base
  title={`${app.data.name} — ${sectionName} — Appservatory`}
  description={app.data.summary.slice(0, 155)}
  current="case-studies"
>
  <CaseStudySectionV41 app={app.data} section={section} mechanicsById={byId} />
</Base>
