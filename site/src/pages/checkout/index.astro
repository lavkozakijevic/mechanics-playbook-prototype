---
// /checkout/?plan=quarterly|yearly. A page, not an action: loading it never
// creates a transaction (a link from another site must not be able to). It
// decides what to show; the transaction is made by the POST that
// /assets/checkout/checkout.js sends, which is Origin-checked and rate-limited.
//
//   no session          -> login, then straight back here
//   already has access  -> a message (never a second checkout)
//   otherwise           -> loads Paddle.js and opens checkout
//
// Deliberately not Base.astro (see AuthLayout): nothing here touches content.
import { env } from "cloudflare:workers";
import AuthLayout from "../../layouts/AuthLayout.astro";
import { Button } from "../../components/ds/Button.jsx";
import { AUTH_HEADERS, authResponse, hasAuthCookie, setCookieLines } from "../../lib/auth-config.mjs";
import { createRequestClient, finalCookies, supabaseConfigured } from "../../lib/auth-server.mjs";
import { CHECKOUT_CSP, CHECKOUT_CSP_HEADER, PLAN_COPY, checkoutPath, loginRedirect, parsePlan, stateCopy } from "../../lib/checkout.mjs";

export const prerender = false;

for (const [k, v] of Object.entries(AUTH_HEADERS)) Astro.response.headers.set(k, v);

const request = Astro.request;
const redirect = (to: string, cookies: { name: string; value: string; options: object }[] = []) =>
  authResponse(null, { status: 303, json: false, headers: { Location: to }, cookies });

if (request.method !== "GET") {
  return authResponse("Method not allowed", { status: 405, json: false, headers: { Allow: "GET", "Content-Type": "text/plain; charset=utf-8" } });
}

const plan = parsePlan(new URL(request.url).searchParams.get("plan"));
if (!plan) return redirect("/subscribe/");
const here = checkoutPath(plan);

// Subscribing needs an account: no session goes to login and comes back here.
if (!hasAuthCookie(request)) return redirect(loginRedirect(here));

let ready = false;
let message: string | null = null;
let copy: ReturnType<typeof stateCopy> = null;

if (!supabaseConfigured(env) || !(env as any).PAYMENTS) {
  Astro.response.status = 503;
  message = "Checkout isn't available right now. Try again later.";
} else {
  const { supabase, state } = createRequestClient(request, env);
  const { data: userData } = await supabase.auth.getUser();
  if (!userData?.user) return redirect(loginRedirect(here), finalCookies(state));
  for (const line of setCookieLines(finalCookies(state))) Astro.response.headers.append("Set-Cookie", line);

  const { data: sessionData } = await supabase.auth.getSession();
  let out: any = null;
  try {
    out = await (env as any).PAYMENTS.status({ accessToken: sessionData?.session?.access_token });
  } catch {
    console.error(JSON.stringify({ evt: "checkout_page", reason: "binding_failed" }));
  }
  if (out?.ok === false && out.reason === "unauthorized") return redirect(loginRedirect(here));
  if (out?.ok !== true) {
    Astro.response.status = 503;
    message = "Checkout isn't available right now. Try again in a moment.";
  } else if (out.state === "ready") {
    ready = true;
    // Only this response loads Paddle.js, so only this one carries the policy.
    Astro.response.headers.set(CHECKOUT_CSP_HEADER, CHECKOUT_CSP);
  } else {
    copy = stateCopy(out.state, out.until, out.billing === true);
    if (!copy) {
      Astro.response.status = 503;
      message = "Checkout isn't available right now. Try again in a moment.";
    }
  }
}
---

<AuthLayout title="Subscribe to Appservatory">
  <main class="login" id="main">
    <div class="login__card">
      <a class="login__brand" href="/" aria-label="Appservatory home">
        <img src="/assets/logo/appservatory-logo.png" alt="Appservatory" width="123" height="25" />
      </a>

      {message && <p class="login__status login__status--error" role="alert">{message}</p>}

      {copy && (
        <div class="login__form">
          <h1 class="login__heading">{copy.heading}</h1>
          <p class="login__lead">{copy.body}</p>
          <Button as="a" href={copy.link.href} variant="primary" size="lg" className="login__submit">{copy.link.label}</Button>
          {copy.secondary && <p class="login__alt"><a href={copy.secondary.href} rel="nofollow">{copy.secondary.label}</a></p>}
        </div>
      )}

      {ready && (
        <Fragment>
        <div class="login__form" data-checkout data-plan={plan}>
          <h1 class="login__heading">Subscribe to Appservatory</h1>
          <p class="login__lead"><strong>{PLAN_COPY[plan].name}</strong>: {PLAN_COPY[plan].price}</p>
          <p class="login__lead" data-status role="status" aria-live="polite">Opening secure checkout…</p>
          <Button variant="primary" size="lg" type="button" className="login__submit" data-open hidden>Open checkout</Button>
          <noscript><p class="login__status login__status--error">Checkout needs JavaScript. Turn it on for this page and reload.</p></noscript>
          <p class="login__alt">
            By subscribing you agree to the <a href="/terms-of-use/">Terms of Use</a>. See the <a href="/refund-policy/">Refund Policy</a>.
            <a href="/subscribe/">Choose a different plan</a>
          </p>
        </div>
        <script is:inline src="https://cdn.paddle.com/paddle/v2/paddle.js"></script>
        <script is:inline src="/assets/checkout/checkout.js" defer></script>
        </Fragment>
      )}

    </div>
  </main>
</AuthLayout>
