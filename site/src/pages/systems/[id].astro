---
import { getEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import { SystemDetailPage } from "../../components/site/SystemDetail.jsx";
import { publishedApps, publishedMechanics } from "../../lib/content";
import { systemProps } from "../../lib/props";

export async function getStaticPaths() {
  return (await publishedApps())
    .filter((a) => a.data.system)
    .map((app) => ({ params: { id: app.data.id }, props: { app } }));
}

const { app } = Astro.props;
const byId = new Map((await publishedMechanics()).map((m) => [m.data.id, m.data]));
const system = systemProps(app.data, byId);
// System pages named in settings.freeSystemApps open as free samples even when
// their app is subscriber-gated (the rotating free slot). Everything else that
// is not public shows the subscribe gate.
const freeSystems = new Set((await getEntry("settings", "homepage"))!.data.freeSystemApps);
const locked = app.data.visibility !== "public" && !freeSystems.has(app.data.id);
---

<Base
  title={`${app.data.name} system map — Mechanics Playbook`}
  description={app.data.system!.tagline.slice(0, 155)}
  current="systems"
>
  <SystemDetailPage client:load system={system} locked={locked} />
</Base>
