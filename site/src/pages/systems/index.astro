---
import { getEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import { SystemsPage } from "../../components/site/Systems.jsx";
import { publishedApps, publishedMechanics } from "../../lib/content";
import { systemProps } from "../../lib/props";

const byId = new Map((await publishedMechanics()).map((m) => [m.data.id, m.data]));
const withSystems = (await publishedApps()).filter((a) => a.data.system);
// System pages listed in settings open as free samples even when their app
// is subscriber-gated (Strava, per the owner's ruling).
const freeSystems = new Set((await getEntry("settings", "homepage"))!.data.freeSystemApps);
const systems = withSystems.map((a) => {
  const p = systemProps(a.data, byId);
  const locked = a.data.visibility !== "public" && !freeSystems.has(a.data.id);
  return {
    id: a.data.id,
    name: a.data.name,
    oneLiner: a.data.system!.tagline,
    href: locked ? "/subscribe/" : `/systems/${a.data.id}/`,
    nodes: p.nodes,
    connections: p.connections,
    type: a.data.type === "game" ? "Game" : "App",
    locked,
  };
}).sort((a, b) => {
  if (!a.locked && b.locked) return -1;
  if (a.locked && !b.locked) return 1;
  return 0;
});
---

<Base
  title="Systems — Appservatory"
  description="How each app's mechanics interconnect: the loops, the triggers, and the moments where one mechanic hands the player to the next."
  current="systems"
>
  <SystemsPage systems={systems} />
</Base>
