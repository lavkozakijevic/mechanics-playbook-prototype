---
import Base from "../../layouts/Base.astro";
---

<Base
  title="Reports — Mechanics Playbook"
  description="In-depth research reports on how engagement mechanics are applied across specific verticals — starting with fintech and banking."
  current="reports"
>
  <main id="main">
    <section class="band--tight lib-head">
      <div class="container">
        <div class="eyebrow lib-head__eyebrow">Research</div>
        <h1>Reports</h1>
        <p>In-depth analysis of how engagement mechanics are applied across a vertical — who uses what, how they present it, and where the openings are for products that haven't caught up yet.</p>
      </div>
    </section>

    <section class="band">
      <div class="container">
        <div class="report-landing">
          <div class="report-landing__card">
            <div class="eyebrow" style="color:var(--text-accent);margin-bottom:12px">First report</div>
            <h2>Gamification in Finance</h2>
            <p style="font:var(--type-body-lg);color:var(--text-secondary);max-width:52ch;margin-bottom:24px">What banking and fintech apps rely on for engagement and retention, app by app, mechanic by mechanic — and where the openings are for products that haven't caught up yet.</p>
            <div class="report-landing__stats">
              <div class="report-landing__stat"><span class="report-landing__n">9</span><span class="report-landing__l">apps analysed</span></div>
              <div class="report-landing__stat"><span class="report-landing__n">7</span><span class="report-landing__l">chapters</span></div>
              <div class="report-landing__stat"><span class="report-landing__n">25+</span><span class="report-landing__l">opportunities identified</span></div>
            </div>
            <a class="gb-btn gb-btn--primary" href="/subscribe/" style="margin-top:28px">Get access →</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</Base>
