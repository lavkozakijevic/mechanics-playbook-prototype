---
// /account/delete/: the confirmation page for deleting an account. Rendered on
// request, signed-in only, and deliberately not Base.astro (see AuthLayout): it
// touches no content.
//
//   no session           -> login, then straight back here
//   sign-in over 10 min  -> "email me a confirmation link", which signs in again
//                           and returns here
//   otherwise            -> what will happen, and the typed confirmation
//
// The page only asks. The deletion itself is POST /api/account/delete, and the
// payments Worker checks the typed word and the sign-in time again.
import { env } from "cloudflare:workers";
import AuthLayout from "../../../layouts/AuthLayout.astro";
import { Button } from "../../../components/ds/Button.jsx";
import { AUTH_HEADERS, authResponse, hasAuthCookie, setCookieLines } from "../../../lib/auth-config.mjs";
import { createRequestClient, finalCookies, supabaseConfigured } from "../../../lib/auth-server.mjs";
import { ACCOUNT_PATH, BILLING_PATH, CONFIRM_WORD, DELETE_COPY, DELETE_ERRORS, DELETE_PATH, deleteSituation, isFreshSignIn } from "../../../lib/account.mjs";
import { loginRedirect } from "../../../lib/checkout.mjs";

export const prerender = false;

for (const [k, v] of Object.entries(AUTH_HEADERS)) Astro.response.headers.set(k, v);

const request = Astro.request;
const redirect = (to: string, cookies: { name: string; value: string; options: object }[] = []) =>
  authResponse(null, { status: 303, json: false, headers: { Location: to }, cookies });

if (request.method !== "GET") {
  return authResponse("Method not allowed", { status: 405, json: false, headers: { Allow: "GET", "Content-Type": "text/plain; charset=utf-8" } });
}

if (!hasAuthCookie(request)) return redirect(loginRedirect(DELETE_PATH));

let email: string | null = null;
let fresh = false;
let situation = deleteSituation(null);
let message: string | null = null;

if (!supabaseConfigured(env) || !(env as any).PAYMENTS) {
  Astro.response.status = 503;
  message = DELETE_COPY.unavailable;
} else {
  const { supabase, state } = createRequestClient(request, env);
  const { data: userData } = await supabase.auth.getUser();
  if (!userData?.user) return redirect(loginRedirect(DELETE_PATH), finalCookies(state));
  for (const line of setCookieLines(finalCookies(state))) Astro.response.headers.append("Set-Cookie", line);
  email = userData.user.email ?? null;
  fresh = isFreshSignIn(userData.user.last_sign_in_at);

  const { data: sessionData } = await supabase.auth.getSession();
  let out: any = null;
  try {
    out = await (env as any).PAYMENTS.status({ accessToken: sessionData?.session?.access_token });
  } catch {
    console.error(JSON.stringify({ evt: "delete_page", reason: "binding_failed" }));
  }
  if (out?.ok === true) {
    situation = deleteSituation(out);
  } else {
    Astro.response.status = 503;
    message = DELETE_COPY.unavailable;
    email = null;
  }
}
---

<AuthLayout title={DELETE_COPY.title}>
  <main class="login" id="main">
    <div class="login__card">
      <a class="login__brand" href="/" aria-label="Appservatory home">
        <img src="/assets/logo/appservatory-logo.png" alt="Appservatory" width="123" height="25" />
      </a>

      {message && <p class="login__status login__status--error" role="alert">{message}</p>}

      {email && (
        <div class="login__form" data-delete data-fresh={fresh ? "yes" : "no"} data-email={email}
          data-msg-confirm={DELETE_ERRORS.confirm} data-msg-reauth_required={DELETE_ERRORS.reauth_required}
          data-msg-cancel_failed={DELETE_ERRORS.cancel_failed} data-msg-delete_failed={DELETE_ERRORS.delete_failed}
          data-msg-unavailable={DELETE_ERRORS.unavailable} data-msg-rate_limited={DELETE_ERRORS.rate_limited}
          data-msg-network={DELETE_ERRORS.network} data-msg-send_failed={DELETE_ERRORS.send_failed}
          data-msg-sent={DELETE_COPY.freshSent} data-confirm-word={CONFIRM_WORD}>
          <h1 class="login__heading">{DELETE_COPY.heading}</h1>
          <p class="login__lead">{DELETE_COPY.lead}</p>
          {situation.subscription && (
            <p class="login__lead">{DELETE_COPY.subscriptionBefore}<a href={DELETE_COPY.refundHref}>{DELETE_COPY.refundLabel}</a>{DELETE_COPY.subscriptionAfter}</p>
          )}
          {situation.manual && <p class="login__lead">{DELETE_COPY.manual}</p>}
          {situation.billing && (
            <p class="login__lead">{DELETE_COPY.invoicesBefore}<a href={BILLING_PATH} rel="nofollow">{DELETE_COPY.invoicesLabel}</a>{DELETE_COPY.invoicesAfter}</p>
          )}

          {fresh ? (
            <form class="login__form" data-delete-form autocomplete="off" novalidate>
              <label class="acct__label" for="delete-confirm">{DELETE_COPY.confirmLabel}</label>
              <div class="gb-input gb-input--lg">
                <input id="delete-confirm" name="confirm" type="text" autocomplete="off" autocapitalize="characters" spellcheck="false" />
              </div>
              <Button variant="primary" size="lg" type="submit" className="login__submit" data-delete-submit disabled>{DELETE_COPY.submit}</Button>
            </form>
          ) : (
            <div class="login__form">
              <p class="login__lead">{DELETE_COPY.freshLead}</p>
              <Button variant="primary" size="lg" type="button" className="login__submit" data-fresh-send>{DELETE_COPY.freshSubmit}</Button>
            </div>
          )}
          <p class="login__status login__status--error" role="alert" data-delete-status hidden></p>
          <p class="acct__note" role="status" data-delete-note hidden></p>
          <p class="login__alt"><a href={ACCOUNT_PATH}>{DELETE_COPY.keep}</a></p>
        </div>
      )}
    </div>
  </main>
  {email && <script is:inline src="/assets/account/delete.js" defer></script>}
</AuthLayout>
