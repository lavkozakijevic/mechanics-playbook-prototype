---
import { getEntry } from "astro:content";
import Base from "../layouts/Base.astro";
import { HomeTop } from "../components/site/HomeTop.jsx";
import { HomeBottom } from "../components/site/HomeBottom.jsx";
import { publishedApps, publishedMechanics, formatDate, mechanicHref } from "../lib/content";
import { dominantCategory, systemProps } from "../lib/props";
import { tagBlocks } from "../lib/v41";
import { SITE_TAGLINE } from "../lib/site-copy";

const apps = await publishedApps();
const mechanics = await publishedMechanics();
const byId = new Map(mechanics.map((m) => [m.data.id, m.data]));
const settings = (await getEntry("settings", "homepage"))!.data;

const spotlightApp = apps.find((a) => a.data.id === settings.spotlightApp)!.data;
const appsById = new Map(apps.map((a) => [a.data.id, a.data]));

// Hero carousel: fixed app-mechanic pairings, each verified to have a complete
// write-up. A card needs the app's write-up for that mechanic to carry a headline
// (summary) and a How it works (the old shape's equivalent counts too); the write-up is found through tagBlocks(), the same
// tag-to-mechanic resolution every case study page uses. A pairing that fails is
// skipped silently rather than showing a broken card. Only the app name, the
// mechanic name and a title built from them reach the card, never write-up text, so
// nothing protected is exposed. Fewer than MIN_CAROUSEL_CARDS qualifying pairings
// and the hero shows its static image instead (HomeTop).
const CAROUSEL_PAIRINGS = [
  { appId: "strava",                  mechId: "leaderboard"    },
  { appId: "fifa-panini-collection",  mechId: "set-collection" },
  { appId: "fortune-city",            mechId: "personal-data-reflection" },
  { appId: "insight-timer",           mechId: "streak"         },
  { appId: "canva",                   mechId: "achievement"    },
];

const shortShot = (s?: string) => (s ? s.split(/ showing | with |,/)[0] : "Screen study");
const carousel = CAROUSEL_PAIRINGS
  .map(({ appId, mechId }) => {
    const app = appsById.get(appId);
    const mech = byId.get(mechId);
    if (!app || !mech || app.contentFormat !== "v4.1") return null;
    const block = tagBlocks(app, byId).find((b) => b.mechanic?.id === mechId);
    const w = block?.writeup;
    // "How it works" is the new voice shape's field; the write-ups not yet rewritten
    // carry its equivalent as What was observed + How it is presented. Either
    // counts, so the slider does not wait on the voice rewrite.
    const howItWorks = w?.howItWorks?.trim() || (w?.observed?.trim() && w?.presented?.trim());
    if (!w?.summary?.trim() || !howItWorks) return null;
    return {
      appId,
      app: app.name,
      mechanic: mech.name,
      cat: mech.cat,
      title: `How ${app.name} uses ${mech.name}`,
    };
  })
  .filter(Boolean);

const stats = {
  caseStudies: apps.length,
  systems: apps.filter((a) => a.data.system).length,
  cheatsheets: settings.cheatsheetCount,
};

const spotlight = {
  name: spotlightApp.name,
  category: dominantCategory(spotlightApp, byId),
  overview: spotlightApp.summary,
  keyInsight: "",
  href: `/case-studies/${spotlightApp.id}/`,
  imageSrc: spotlightApp.heroImage,
  imageAlt: `${spotlightApp.name} screenshots`,
  // v4.1 apps carry no `mechanics` array (same gap the carousel above already
  // handles) — pull a screen label from the first composed mechanic block's
  // own screenshots note instead of a v3 "core" relationship's suggestedShots.
  screenLabel:
    spotlightApp.contentFormat === "v4.1"
      ? shortShot(spotlightApp.mechanicWriteups?.[0]?.screenshotsNote)
      : shortShot(spotlightApp.mechanics.find((r) => r.depth === "core")?.suggestedShots[0]),
  date: formatDate(spotlightApp.analysisDate),
};

// System map showcase: follows the rotating free slot (settings written by
// the convert script, guarded by validation), so it never links into the
// paywall.
const showcaseApp = apps.find((a) => a.data.id === settings.showcaseSystem)?.data;
const showcase = showcaseApp?.system
  ? (() => {
      const p = systemProps(showcaseApp, byId);
      return {
        name: showcaseApp.name,
        tagline: showcaseApp.system.tagline,
        href: `/systems/${showcaseApp.id}/`,
        nodes: p.nodes,
        connections: p.connections,
      };
    })()
  : null;

const featured = settings.featuredMechanics
  .map((id) => byId.get(id))
  .filter(Boolean)
  .map((m) => {
    // Three of the six curated featuredMechanics ids (energy-lives,
    // season-pass, leaderboards) are currently held back
    // (sources/taxonomy-map.md); MechanicCard renders them unlinked with a
    // lock badge rather than 404ing or misleadingly offering a subscribe CTA.
    const href = mechanicHref(m!.id, m!.visibility);
    return {
      number: m!.n,
      category: m!.cat,
      name: m!.name,
      definition: m!.tagline,
      contextTags: (m!.context ?? []).map((c) => c.charAt(0).toUpperCase() + c.slice(1)),
      locked: !href,
      href,
    };
  });

// Latest entries — curated (owner-set). These are the newest additions; each is
// subscriber content, so all link to /subscribe/.
const newThisWeek = [
  // DoorDash's entry was removed here (owner ruling, 16 Sep 2026): the new
  // three-publishable-tag minimum unpublished it, and this list is a
  // hand-curated homepage widget, not derived from the content collection,
  // so nothing else would have caught or fixed a stale mention here.
  { title: "Wakeout case study", date: "Aug 03, 2026", href: "/subscribe/" },
  { title: "Insight Timer case study", date: "Aug 03, 2026", href: "/subscribe/" },
];
---

<Base
  title={`Appservatory — ${SITE_TAGLINE.toLowerCase()}`}
  description="A library of the mechanics behind the best apps and games: what they are, why they work, and how real apps use them. Updated weekly."
  current="home"
>
  <HomeTop client:load carousel={carousel} stats={stats} spotlight={spotlight} />
  <HomeBottom featured={featured} newThisWeek={newThisWeek} showcase={showcase} />
</Base>
