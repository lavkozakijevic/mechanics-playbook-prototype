---
// Layout for pages that render on request (the sign-in confirmation page).
// Deliberately not Base.astro: that layout loads every content collection,
// which would bake the whole content store, report-only apps included, into
// the Worker bundle. This one touches no content at all.
import "../styles/global.css";

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="robots" content="noindex" />
    <meta name="referrer" content="strict-origin" />
    <link rel="icon" href="/assets/logo/favicon.png" type="image/png" />
    <link rel="preload" href="/assets/fonts/sora-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/assets/fonts/dm-sans-400.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <slot />
  </body>
</html>
