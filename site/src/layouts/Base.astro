---
import "../styles/global.css";
import { getCollection } from "astro:content";
import { SiteNav, NewsletterBlock, SiteFooter } from "../components/site/SiteChrome.jsx";
import { lastUpdated, formatDate } from "../lib/content";

interface Props {
  title: string;
  description: string;
  current?: string;
  newsletter?: boolean;
  /** false renders the page without nav/footer — the design's standalone
   *  pages (log in) carry their own brand mark instead of the chrome. */
  chrome?: boolean;
}
const { title, description, current, newsletter = true, chrome = true } = Astro.props;
const updated = formatDate(await lastUpdated());

// Category landing pages drive the footer "Practice" column; adding a category
// file lists it in the footer with no chrome edit.
const categories = (await getCollection("categories"))
  .map((c) => ({ slug: c.data.slug, name: c.data.navLabel ?? c.data.name, desc: c.data.navDesc, order: c.data.order }))
  .sort((a, b) => a.order - b.order || a.name.localeCompare(b.name));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/assets/logo/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/assets/logo/favicon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href="/assets/fonts/sora-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/assets/fonts/dm-sans-400.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    {chrome && <SiteNav client:load current={current} />}
    <slot />
    {chrome && newsletter && <NewsletterBlock client:visible />}
    {chrome && <SiteFooter lastUpdated={updated} categories={categories} />}
  </body>
</html>
